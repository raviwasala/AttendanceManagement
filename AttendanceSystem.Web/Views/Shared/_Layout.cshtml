@inject AttendanceSystem.Application.Interfaces.ISettingsService AmsSettings
@{
    // Read once per render and handed to the browser below. Settings is a single row, and
    // reading it here keeps the page-size config synchronous — the alternative is every list
    // screen firing an extra request and rendering an unpaged flash first.
    var amsSettingsResult = await AmsSettings.GetAsync();
    var amsPageSize = amsSettingsResult.IsSuccess ? amsSettingsResult.Data!.DefaultPageSize : 25;
    var amsConfirmDelete = !amsSettingsResult.IsSuccess || amsSettingsResult.Data!.ConfirmBeforeDelete;
    var amsLockMinutes = amsSettingsResult.IsSuccess ? amsSettingsResult.Data!.ScreenLockMinutes : 15;

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Helper: returns "active" CSS class when current route matches
    string Nav(string c, string a = "") =>
        controller.Equals(c, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(a) || action.Equals(a, StringComparison.OrdinalIgnoreCase))
        ? "active" : "";

    // Opens a collapsible group when the page currently shown is one of its children, so a
    // user never lands on a page whose menu entry is hidden inside a collapsed parent.
    // Matching on the controller cannot do this: every admin page shares the "Admin"
    // controller, so it would expand every group at once. Hence the match on action names.
    string OpenIf(params string[] actions) =>
        actions.Any(a => action.Equals(a, StringComparison.OrdinalIgnoreCase))
            ? "pcoded-trigger active" : "";

    // Helper: true when the signed-in user may view the given module. Used to hide menu
    // entries that would only lead to an Access Denied page. This is presentation only —
    // the binding check lives on the controller action, not here.
    bool CanView(string module) =>
        ViewContext.HasPermission(module, AttendanceSystem.Common.Constants.AppConstants.Actions.View);

    // True when at least one module in a sidebar group is visible. Used to drop the whole
    // group — heading included — rather than leaving a bare heading over an empty list.
    bool CanViewAny(params string[] modules) => modules.Any(CanView);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " – " : "")Attendance Management System</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="icon" href="~/assets/images/favicon.ico" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600" rel="stylesheet">
    <!-- Bootstrap (local) -->
    <link rel="stylesheet" type="text/css" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <!-- Feather icons (local assets) -->
    <link rel="stylesheet" type="text/css" href="~/assets/icon/feather/css/feather.css">
    <!-- Icofont -->
    <link rel="stylesheet" type="text/css" href="~/assets/icon/icofont/css/icofont.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" type="text/css" href="~/assets/icon/font-awesome/css/font-awesome.min.css">
    @* Select2 base styles must precede the theme, because assets/css/style.css carries
       Adminty's own select2 overrides and those have to win. *@
    <link rel="stylesheet" type="text/css" href="~/lib/select2/css/select2.min.css">
    <!-- Theme style (local assets) -->
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/jquery.mCustomScrollbar.css">
    <!-- Adminty teal colour overrides (must come after template CSS) -->
    <link rel="stylesheet" type="text/css" href="~/css/site.css" asp-append-version="true">
    @* Neutral Select2 appearance. Must come after style.css and site.css — it
       matches the theme's selector specificity, so load order is what decides. *@
    <link rel="stylesheet" type="text/css" href="~/css/ams-select2.css" asp-append-version="true">
    <!-- Toastr & SweetAlert2 UI Framework Alerts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- Pre-loader start -->
    <div class="theme-loader">
        <div class="ball-scale">
            <div class='contain'>
                <div class="ring"><div class="frame"></div></div>
                <div class="ring"><div class="frame"></div></div>
                <div class="ring"><div class="frame"></div></div>
                <div class="ring"><div class="frame"></div></div>
                <div class="ring"><div class="frame"></div></div>
            </div>
        </div>
    </div>
    <!-- Pre-loader end -->

    <div id="pcoded" class="pcoded">
        <div class="pcoded-overlay-box"></div>
        <div class="pcoded-container navbar-wrapper">

            <!-- =========================================================
                 TOP NAVBAR
            ========================================================== -->
            <nav class="navbar header-navbar pcoded-header">
                <div class="navbar-wrapper">

                    <!-- Logo -->
                    @* Element order matches the stock Adminty template. The theme absolutely
                       positions .mobile-menu at the left of this block and expects the logo
                       after it; putting the logo first with flex-grow-1 consumed that space
                       and the hamburger landed on top of the logo on small screens. *@
                    <div class="navbar-logo">
                        <a class="mobile-menu" id="mobile-collapse" href="#!">
                            <i class="feather icon-menu"></i>
                        </a>
                        <a asp-controller="Admin" asp-action="Index">
                            <img class="img-fluid header-brand-logo" src="~/assets/images/samanmal_logo.png" alt="Samanmal Life Style Store"
                                 onerror="this.src='/assets/images/logo.png'" />
                        </a>
                        <a class="mobile-options">
                            <i class="feather icon-more-horizontal"></i>
                        </a>
                    </div>
                    <!-- /Logo -->

                    <div class="navbar-container container-fluid">
                        <ul class="nav-left">
                            <li class="header-search">
                                <div class="main-search morphsearch-search">
                                    <div class="input-group">
                                        <span class="input-group-addon search-close"><i class="feather icon-x"></i></span>
                                        <input type="text" class="form-control" placeholder="Search...">
                                        <span class="input-group-addon search-btn"><i class="feather icon-search"></i></span>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <a href="#!" onclick="javascript:toggleFullScreen()">
                                    <i class="feather icon-maximize full-screen"></i>
                                </a>
                            </li>
                            @* The working payroll month, visible from every screen. Somebody
                               keying figures all afternoon should not have to remember which
                               month they are posting into, or open a screen to find out. *@
                            @if (CanView(AppConstants.Modules.Payroll))
                            {
                                <li class="ams-period-slot"><span id="amsPeriodBadge"></span></li>
                            }
                        </ul>

                        <ul class="nav-right">
                            @* Notifications — populated from /api/notifications by site.js.
                               This markup previously carried a hardcoded "5" and two invented
                               messages, which read as a working feature while telling nobody
                               anything true. *@
                            <li class="header-notification">
                                <div class="dropdown-primary dropdown">
                                    <div class="dropdown-toggle" data-bs-toggle="dropdown" data-toggle="dropdown" style="cursor:pointer;">
                                        <i class="feather icon-bell"></i>
                                        @* Hidden via inline style rather than .d-none: the theme
                                           positions this badge absolutely and its rules win over
                                           a utility class, leaving a stray "0" on screen. *@
                                        <span class="badge bg-c-pink" id="notifBadge" style="display:none;">0</span>
                                    </div>
                                    <ul class="show-notification notification-view dropdown-menu ams-notif"
                                        data-dropdown-in="fadeIn" data-dropdown-out="fadeOut"
                                        id="notifMenu">
                                        <li class="ams-notif-head">
                                            <span class="ams-notif-title">Notifications</span>
                                            <span class="ams-notif-count" id="notifCount"></span>
                                        </li>
                                        <li class="ams-notif-body" id="notifItems">
                                            <div class="ams-notif-empty">
                                                <div class="spinner-border spinner-border-sm text-muted"></div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </li>

                            <!-- User Profile -->
                            @{
                                var _fullName  = Context.Session.GetString("FullName")  ?? Context.Session.GetString("Username") ?? "Admin";
                                var _roleName  = Context.Session.GetString("RoleName")  ?? "";
                                var _initial   = _fullName.Length > 0 ? _fullName.Substring(0,1).ToUpper() : "A";
                            }
                            <li class="user-profile header-notification">
                                <div class="dropdown-primary dropdown">
                                    <div class="dropdown-toggle" data-bs-toggle="dropdown" data-toggle="dropdown" style="cursor:pointer;">
                                        <!-- Avatar initials instead of a missing image -->
                                        <span class="d-inline-flex align-items-center justify-content-center img-radius"
                                              style="width:40px;height:40px;background:#01a9ac;color:#fff;font-weight:700;font-size:1rem;flex-shrink:0;">
                                            @_initial
                                        </span>
                                        <span class="ms-1">@_fullName</span>
                                        <i class="feather icon-chevron-down"></i>
                                    </div>
                                    <ul class="show-notification profile-notification dropdown-menu"
                                        data-dropdown-in="fadeIn" data-dropdown-out="fadeOut">

                                        <!-- User info header -->
                                        <li class="profile-header px-3 pt-2 pb-1" style="pointer-events:none;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                                      style="width:44px;height:44px;background:#01a9ac;color:#fff;font-weight:700;font-size:1.1rem;flex-shrink:0;">
                                                    @_initial
                                                </span>
                                                <div>
                                                    <div class="fw-semibold" style="font-size:.9rem;line-height:1.2;">@_fullName</div>
                                                    @if (!string.IsNullOrEmpty(_roleName))
                                                    {
                                                        <small class="text-muted">@_roleName</small>
                                                    }
                                                </div>
                                            </div>
                                        </li>

                                        <li>
                                            <a asp-controller="Auth" asp-action="Profile">
                                                <i class="feather icon-user"></i> My Profile
                                            </a>
                                        </li>
                                        @if (CanView(AppConstants.Modules.Settings))
                                        {
                                            <li>
                                                <a asp-controller="Admin" asp-action="Settings">
                                                    <i class="feather icon-settings"></i> Settings
                                                </a>
                                            </li>
                                        }
                                        @* Locking on demand, for stepping away deliberately
                                           rather than waiting for the idle timer. *@
                                        <li>
                                            <a href="#" onclick="amsLockScreen();return false;">
                                                <i class="feather icon-lock"></i> Lock screen
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#" id="logoutTrigger" class="logout-link">
                                                <i class="feather icon-log-out"></i> Logout
                                            </a>
                                            <form id="logoutForm" asp-controller="Auth" asp-action="Logout"
                                                  method="post" style="display:none;">
                                                @Html.AntiForgeryToken()
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <!-- /TOP NAVBAR -->

            <!-- =========================================================
                 MAIN CONTAINER
            ========================================================== -->
            <div class="pcoded-main-container">
                <div class="pcoded-wrapper">

                    <!-- =========================================================
                         LEFT SIDEBAR NAVIGATION
                    ========================================================== -->
                    <nav class="pcoded-navbar">

                        @*
                            Menu search. The sidebar carries roughly forty screens across nine
                            collapsed groups, so finding one means guessing which group it is in.
                            Typing filters every entry by name and opens the groups that match,
                            which also answers "does this system have X?" without a hunt.

                            Deliberately not a select2 or a server call: it filters the DOM that
                            is already rendered, so it can only ever offer pages this user is
                            permitted to see. A search index built server-side would have to
                            repeat the permission checks to stay honest.
                        *@
                        <div class="ams-menu-search">
                            <i class="feather icon-search"></i>
                            <input type="text" id="amsMenuSearch" autocomplete="off"
                                   placeholder="Search menu…  (Ctrl+K)" aria-label="Search menu">
                            <button type="button" id="amsMenuSearchClear" aria-label="Clear search">&times;</button>
                        </div>
                        <div class="ams-menu-noresult" id="amsMenuNoResult">No menu item matches.</div>

                        <div class="pcoded-inner-navbar main-menu">

                            @*
                                Collapsible groups using the theme's own pcoded-hasmenu /
                                pcoded-submenu pattern, driven by pcoded.min.js (MenuTrigger:"click").
                                Flat lists made the sidebar taller than most screens once Shift Roster,
                                Attendance Review and Devices were added.

                                A group carries "pcoded-trigger active" when the current page is one of
                                its children, so nobody lands on a page whose menu entry is collapsed
                                out of sight.
                            *@

                            @* Self-service first: it needs no permission beyond being signed
                               in, and for an employee it is the only section that matters. *@
                            <div class="pcoded-navigatio-lavel">My Space</div>
                            <ul class="pcoded-item pcoded-left-item">
                                <li class="@Nav("Me","Attendance")">
                                    <a asp-controller="Me" asp-action="Attendance">
                                        <span class="pcoded-micon"><i class="feather icon-user-check"></i></span>
                                        <span class="pcoded-mtext">My Attendance</span>
                                    </a>
                                </li>
                                <li class="@Nav("Me","Leave")">
                                    <a asp-controller="Me" asp-action="Leave">
                                        <span class="pcoded-micon"><i class="feather icon-calendar"></i></span>
                                        <span class="pcoded-mtext">My Leave</span>
                                    </a>
                                </li>
                            </ul>

                            <div class="pcoded-navigatio-lavel">Navigation</div>
                            <ul class="pcoded-item pcoded-left-item">

                                @if (CanView(AppConstants.Modules.Dashboard))
                                {
                                <li class="@Nav("Admin","Index")">
                                    <a asp-controller="Admin" asp-action="Index">
                                        <span class="pcoded-micon"><i class="feather icon-home"></i></span>
                                        <span class="pcoded-mtext">Dashboard</span>
                                    </a>
                                </li>
                                }

                                @* ── Employees ─────────────────────────────────────── *@
                                @if (CanViewAny(AppConstants.Modules.Employees, AppConstants.Modules.Departments,
                                                AppConstants.Modules.Designations, AppConstants.Modules.Branches))
                                {
                                <li class="pcoded-hasmenu @OpenIf("Employees","Departments","Designations","Branches")">
                                    <a href="javascript:void(0)">
                                        <span class="pcoded-micon"><i class="feather icon-users"></i></span>
                                        <span class="pcoded-mtext">Employee Management</span>
                                    </a>
                                    <ul class="pcoded-submenu">
                                        @if (CanView(AppConstants.Modules.Employees))
                                        {
                                            <li class="@Nav("Admin","Employees")">
                                                <a asp-controller="Admin" asp-action="Employees">
                                                    <span class="pcoded-mtext">Employees</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Departments))
                                        {
                                            <li class="@Nav("Admin","Departments")">
                                                <a asp-controller="Admin" asp-action="Departments">
                                                    <span class="pcoded-mtext">Departments</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Designations))
                                        {
                                            <li class="@Nav("Admin","Designations")">
                                                <a asp-controller="Admin" asp-action="Designations">
                                                    <span class="pcoded-mtext">Designations</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Branches))
                                        {
                                            <li class="@Nav("Admin","Branches")">
                                                <a asp-controller="Admin" asp-action="Branches">
                                                    <span class="pcoded-mtext">Branches</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                }

                                @* ── Shifts ────────────────────────────────────────── *@
                                @if (CanView(AppConstants.Modules.Shifts))
                                {
                                <li class="pcoded-hasmenu @OpenIf("Shifts","ShiftRoster")">
                                    <a href="javascript:void(0)">
                                        <span class="pcoded-micon"><i class="feather icon-clock"></i></span>
                                        <span class="pcoded-mtext">Shift Management</span>
                                    </a>
                                    <ul class="pcoded-submenu">
                                        <li class="@Nav("Admin","Shifts")">
                                            <a asp-controller="Admin" asp-action="Shifts">
                                                <span class="pcoded-mtext">Shifts &amp; Assignment</span>
                                            </a>
                                        </li>
                                        <li class="@Nav("Admin","ShiftRoster")">
                                            <a asp-controller="Admin" asp-action="ShiftRoster">
                                                <span class="pcoded-mtext">Shift Roster</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                }

                                @* ── Attendance & Leave ────────────────────────────── *@
                                @if (CanViewAny(AppConstants.Modules.Attendance, AppConstants.Modules.Leave,
                                                AppConstants.Modules.Holidays))
                                {
                                <li class="pcoded-hasmenu @OpenIf("Attendance","AttendanceReview","MonthEnd","Leave","Holidays")">
                                    <a href="javascript:void(0)">
                                        <span class="pcoded-micon"><i class="feather icon-check-circle"></i></span>
                                        <span class="pcoded-mtext">Attendance &amp; Leave</span>
                                    </a>
                                    @*
                                        Month End stays here rather than moving to Payroll, even though
                                        it closes the month FOR payroll: the screen is gated on
                                        Attendance.View, and HR Manager, Manager and Supervisor hold that
                                        without holding Payroll.View. Filing it under Payroll would hide
                                        it from exactly the people who run it.
                                    *@
                                    <ul class="pcoded-submenu">
                                        @if (CanView(AppConstants.Modules.Attendance))
                                        {
                                            <li class="@Nav("Admin","Attendance")">
                                                <a asp-controller="Admin" asp-action="Attendance">
                                                    <span class="pcoded-mtext">Attendance Records</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","AttendanceReview")">
                                                <a asp-controller="Admin" asp-action="AttendanceReview">
                                                    <span class="pcoded-mtext">Attendance Review</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Leave))
                                        {
                                            <li class="@Nav("Admin","Leave")">
                                                <a asp-controller="Admin" asp-action="Leave">
                                                    <span class="pcoded-mtext">Leave Management</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Attendance))
                                        {
                                            <li class="@Nav("Admin","MonthEnd")">
                                                <a asp-controller="Admin" asp-action="MonthEnd">
                                                    <span class="pcoded-mtext">Month End &amp; Payroll</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Holidays))
                                        {
                                            <li class="@Nav("Admin","Holidays")">
                                                <a asp-controller="Admin" asp-action="Holidays">
                                                    <span class="pcoded-mtext">Holidays</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                }

                                @* ── Overtime ──────────────────────────────────────── *@
                                @if (CanView(AppConstants.Modules.Overtime))
                                {
                                <li class="pcoded-hasmenu @OpenIf("OvertimeRules","OvertimeApproval","OvertimeRegister","OvertimeSummary")">
                                    <a href="javascript:void(0)">
                                        <span class="pcoded-micon"><i class="feather icon-clock"></i></span>
                                        <span class="pcoded-mtext">Overtime</span>
                                    </a>
                                    @* OT Rules is last because it is configuration, not daily work — the
                                       three screens above it are used every day. *@
                                    <ul class="pcoded-submenu">
                                        <li class="@Nav("Admin","OvertimeApproval")">
                                            <a asp-controller="Admin" asp-action="OvertimeApproval">
                                                <span class="pcoded-mtext">OT Approval</span>
                                            </a>
                                        </li>
                                        <li class="@Nav("Admin","OvertimeRegister")">
                                            <a asp-controller="Admin" asp-action="OvertimeRegister">
                                                <span class="pcoded-mtext">OT Register</span>
                                            </a>
                                        </li>
                                        <li class="@Nav("Admin","OvertimeSummary")">
                                            <a asp-controller="Admin" asp-action="OvertimeSummary">
                                                <span class="pcoded-mtext">OT Summary</span>
                                            </a>
                                        </li>

                                        <li class="@Nav("Admin","OvertimeRules")">
                                            <a asp-controller="Admin" asp-action="OvertimeRules">
                                                <span class="pcoded-mtext">OT Rules</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                }

                                @* ── Payroll ───────────────────────────────────────── *@
                                @if (CanViewAny(AppConstants.Modules.Payroll, AppConstants.Modules.PayrollSetup))
                                {
                                <li class="pcoded-hasmenu @OpenIf("PayrollSetup","EmployeePayroll","SalaryDetails","EmployeeBankAccounts","GroupAssignComponent","PayrollAdmin","Loans","LoanSettlement","TransactionSchedule","ItemWiseTransaction","EmployeeWiseTransaction","PayrollPeriods","PayRegister","Payslip","PaySummary","SalaryIncrements","IncrementConfirmation")">
                                    <a href="javascript:void(0)">
                                        <span class="pcoded-micon"><i class="feather icon-credit-card"></i></span>
                                        <span class="pcoded-mtext">Payroll</span>
                                    </a>
                                    @*
                                        Ordered by the payroll lifecycle rather than alphabetically or by
                                        the order the screens were built: configure the structure, record
                                        what each employee is paid, enter the month's transactions, then
                                        correct. Nine flat entries were impossible to scan, so the stages
                                        carry captions — a clerk running the month reads down one section
                                        instead of hunting the whole list.
                                    *@
                                    <ul class="pcoded-submenu">
                                        @if (CanView(AppConstants.Modules.PayrollSetup))
                                        {
                                            <li class="pcoded-submenu-caption">Setup</li>
                                            <li class="@Nav("Admin","PayrollSetup")">
                                                <a asp-controller="Admin" asp-action="PayrollSetup">
                                                    <span class="pcoded-mtext">Payroll Setup</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Payroll))
                                        {
                                            <li class="pcoded-submenu-caption">Employee Master</li>
                                            <li class="@Nav("Admin","EmployeePayroll")">
                                                <a asp-controller="Admin" asp-action="EmployeePayroll">
                                                    <span class="pcoded-mtext">Employee Payroll</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","SalaryDetails")">
                                                <a asp-controller="Admin" asp-action="SalaryDetails">
                                                    <span class="pcoded-mtext">Salary Details</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","SalaryIncrements")">
                                                <a asp-controller="Admin" asp-action="SalaryIncrements">
                                                    <span class="pcoded-mtext">Salary Increments</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","IncrementConfirmation")">
                                                <a asp-controller="Admin" asp-action="IncrementConfirmation">
                                                    <span class="pcoded-mtext">Increment Confirmation</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","EmployeeBankAccounts")">
                                                <a asp-controller="Admin" asp-action="EmployeeBankAccounts">
                                                    <span class="pcoded-mtext">Employee Bank Accounts</span>
                                                </a>
                                            </li>

                                            <li class="pcoded-submenu-caption">Transactions</li>
                                            <li class="@Nav("Admin","PayrollPeriods")">
                                                <a asp-controller="Admin" asp-action="PayrollPeriods">
                                                    <span class="pcoded-mtext">Payroll Months</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","ItemWiseTransaction")">
                                                <a asp-controller="Admin" asp-action="ItemWiseTransaction">
                                                    <span class="pcoded-mtext">Item wise Transaction</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","EmployeeWiseTransaction")">
                                                <a asp-controller="Admin" asp-action="EmployeeWiseTransaction">
                                                    <span class="pcoded-mtext">Emp Wise Transaction</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","TransactionSchedule")">
                                                <a asp-controller="Admin" asp-action="TransactionSchedule">
                                                    <span class="pcoded-mtext">Transaction Schedule</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","GroupAssignComponent")">
                                                <a asp-controller="Admin" asp-action="GroupAssignComponent">
                                                    <span class="pcoded-mtext">Bulk Value Entry</span>
                                                </a>
                                            </li>

                                            <li class="pcoded-submenu-caption">Loans</li>
                                            <li class="@Nav("Admin","Loans")">
                                                <a asp-controller="Admin" asp-action="Loans">
                                                    <span class="pcoded-mtext">Staff Loans</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","LoanSettlement")">
                                                <a asp-controller="Admin" asp-action="LoanSettlement">
                                                    <span class="pcoded-mtext">Loan Settlement</span>
                                                </a>
                                            </li>

                                            <li class="pcoded-submenu-caption">Reports</li>
                                            <li class="@Nav("Admin","PayRegister")">
                                                <a asp-controller="Admin" asp-action="PayRegister">
                                                    <span class="pcoded-mtext">Pay Register</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","Payslip")">
                                                <a asp-controller="Admin" asp-action="Payslip">
                                                    <span class="pcoded-mtext">Payslips</span>
                                                </a>
                                            </li>
                                            <li class="@Nav("Admin","PaySummary")">
                                                <a asp-controller="Admin" asp-action="PaySummary">
                                                    <span class="pcoded-mtext">Pay Summary</span>
                                                </a>
                                            </li>

                                            <li class="pcoded-submenu-caption">Corrections</li>
                                            <li class="@Nav("Admin","PayrollAdmin")">
                                                <a asp-controller="Admin" asp-action="PayrollAdmin">
                                                    <span class="pcoded-mtext">Payroll Administration</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                }

                                @* ── Devices & Import ──────────────────────────────── *@
                                @if (CanViewAny(AppConstants.Modules.Import, AppConstants.Modules.Devices))
                                {
                                <li class="pcoded-hasmenu @OpenIf("Import","Devices")">
                                    <a href="javascript:void(0)">
                                        <span class="pcoded-micon"><i class="feather icon-cpu"></i></span>
                                        <span class="pcoded-mtext">Biometric Devices</span>
                                    </a>
                                    <ul class="pcoded-submenu">
                                        @if (CanView(AppConstants.Modules.Devices))
                                        {
                                            <li class="@Nav("Admin","Devices")">
                                                <a asp-controller="Admin" asp-action="Devices">
                                                    <span class="pcoded-mtext">Fingerprint Devices</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Import))
                                        {
                                            <li class="@Nav("Admin","Import")">
                                                <a asp-controller="Admin" asp-action="Import">
                                                    <span class="pcoded-mtext">Biometric Import</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                }

                                @* ── Reports ───────────────────────────────────────── *@
                                @if (CanView(AppConstants.Modules.Reports))
                                {
                                <li class="@Nav("Admin","Reports")">
                                    <a asp-controller="Admin" asp-action="Reports">
                                        <span class="pcoded-micon"><i class="feather icon-bar-chart-2"></i></span>
                                        <span class="pcoded-mtext">Reports</span>
                                    </a>
                                </li>
                                }

                            </ul>

                            @* Administration is kept in its own section: it is a different audience
                               and most roles never see any of it. *@
                            @if (CanViewAny(AppConstants.Modules.Users, AppConstants.Modules.Roles,
                                            AppConstants.Modules.Settings, AppConstants.Modules.AuditLogs))
                            {
                            <div class="pcoded-navigatio-lavel">Administration</div>
                            <ul class="pcoded-item pcoded-left-item">

                                @if (CanViewAny(AppConstants.Modules.Users, AppConstants.Modules.Roles))
                                {
                                <li class="pcoded-hasmenu @OpenIf("Users","Roles")">
                                    <a href="javascript:void(0)">
                                        <span class="pcoded-micon"><i class="feather icon-shield"></i></span>
                                        <span class="pcoded-mtext">User Access</span>
                                    </a>
                                    <ul class="pcoded-submenu">
                                        @if (CanView(AppConstants.Modules.Users))
                                        {
                                            <li class="@Nav("Admin","Users")">
                                                <a asp-controller="Admin" asp-action="Users">
                                                    <span class="pcoded-mtext">System Users</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CanView(AppConstants.Modules.Roles))
                                        {
                                            <li class="@Nav("Admin","Roles")">
                                                <a asp-controller="Admin" asp-action="Roles">
                                                    <span class="pcoded-mtext">Role &amp; Access Control</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                }

                                @if (CanView(AppConstants.Modules.Settings))
                                {
                                <li class="@Nav("Admin","Settings")">
                                    <a asp-controller="Admin" asp-action="Settings">
                                        <span class="pcoded-micon"><i class="feather icon-settings"></i></span>
                                        <span class="pcoded-mtext">Settings</span>
                                    </a>
                                </li>
                                @* icon-server, not icon-database: this theme's feather build
                                   has no icon-database glyph, so it renders as blank space. *@
                                <li class="@Nav("Admin","DataManagement")">
                                    <a asp-controller="Admin" asp-action="DataManagement">
                                        <span class="pcoded-micon"><i class="feather icon-server"></i></span>
                                        <span class="pcoded-mtext">Data Management</span>
                                    </a>
                                </li>
                                }

                                @if (CanView(AppConstants.Modules.AuditLogs))
                                {
                                <li class="@Nav("Admin","AuditLogs")">
                                    <a asp-controller="Admin" asp-action="AuditLogs">
                                        <span class="pcoded-micon"><i class="feather icon-file-text"></i></span>
                                        <span class="pcoded-mtext">Audit Log</span>
                                    </a>
                                </li>
                                }

                            </ul>
                            }

                        </div>
                    </nav>
                    <!-- /LEFT SIDEBAR -->

                    <!-- =========================================================
                         PAGE CONTENT
                    ========================================================== -->
                    <div class="pcoded-content">
                        <div class="pcoded-inner-content">

                            <!-- Breadcrumb -->
                            <div class="main-body">
                                <div class="page-wrapper">

                                    @RenderBody()

                                    <!-- Footer -->
                                    <div class="page-footer">
                                        <div class="row align-items-center">
                                            <div class="col-sm-8">
                                                <p class="m-b-0">
                                                    Attendance Management System &copy; @DateTime.Now.Year
                                                    &nbsp;|&nbsp; Built with .NET 10
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /Footer -->

                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- /PAGE CONTENT -->

                </div>
            </div>
            <!-- /MAIN CONTAINER -->

        </div>
    </div>

    <!-- =========================================================
         SCRIPTS
    ========================================================== -->
    <!-- jQuery (local) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap (local) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom scrollbar (local assets) -->
    <script src="~/assets/js/jquery.mCustomScrollbar.concat.min.js"></script>
    @*
        SmoothScroll.js is deliberately NOT loaded. It works by cancelling the browser's
        wheel event and animating the scroll itself, but Chrome now registers wheel
        listeners as passive by default, so its preventDefault() at SmoothScroll.js:357 is
        ignored. The result is the worst of both: the page scrolls natively AND
        SmoothScroll animates it, so every wheel tick moves twice and fights the sidebar's
        own scrollbar — plus an [Intervention] warning per tick, which buries real errors.

        The file stays in assets/ (it is part of the vendored theme); it is only unhooked.
    *@
    <!-- Pcoded sidebar engine (local assets) -->
    <script src="~/assets/js/pcoded.min.js"></script>
    <script src="~/assets/js/vartical-layout.min.js"></script>
    <!-- Dashboard chart helpers (local assets) -->
    <script src="~/assets/pages/dashboard/custom-dashboard.js"></script>
    <!-- App script (local assets) -->
    <script src="~/assets/js/script.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    @* System configuration, emitted before site.js so the pagination helper and the delete
       confirmations can read it synchronously instead of racing an extra request. *@
    <script>
        window.amsConfig = {
            pageSize: @amsPageSize,
            confirmDelete: @(amsConfirmDelete ? "true" : "false"),
            screenLockMinutes: @amsLockMinutes
        };
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Select2 (Adminty's own component, vendored locally) plus the initialiser that
       applies it to every <select>. Loaded before the page scripts so its ready
       handler runs first; it then tracks their .html()/.val() calls, so no page
       script needs to know it exists. *@
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <script src="~/js/ams-select2.js" asp-append-version="true"></script>
    <script src="~/js/ams-menu-search.js" asp-append-version="true"></script>
    <script src="~/js/ams-payroll-period.js" asp-append-version="true"></script>
    @* Idle screen lock. Only decides *when* to lock — the lock itself lives in the
       session and is enforced by SessionAuthorizeAttribute on every request. *@
    <script src="~/js/ams-idle-lock.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

