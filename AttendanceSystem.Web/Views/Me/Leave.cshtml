@{
    ViewData["Title"] = "My Leave";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-1">My Leave</h5>
        <p class="text-muted small mb-0">Your balances and requests for <span id="myLeaveYear"></span></p>
    </div>
    <button class="btn btn-primary btn-sm px-3" onclick="openApplyLeave()">
        <i class="feather icon-plus me-1"></i>Apply for Leave
    </button>
</div>

<div id="myLeaveError" class="alert alert-warning d-none" role="status"></div>

<div class="row g-3">
    <div class="col-xl-5">
        <div class="card h-100">
            <div class="card-header"><strong>Leave Balances</strong></div>
            <div class="card-body" id="myBalances">
                <div class="text-muted small">Loading…</div>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>My Requests</strong>
                <span class="text-muted small" id="myPending"></span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Type</th>
                                <th>Dates</th>
                                <th class="text-center">Days</th>
                                <th>Status</th>
                                <th>Reason</th>
                                <th class="pe-3 text-center" style="width:70px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="myLeaveBody">
                            <tr><td colspan="6" class="text-center py-4 text-muted">Loading…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Apply for leave ─────────────────────────────────────────────────────────
   Posts to /api/me/leave, not /api/leave/requests. The admin endpoint takes an
   EmployeeId in the body and the Employee role holds Leave.Create, so posting
   there would let anyone book leave in a colleague's name. Here the employee
   comes from the session and cannot be supplied. *@
<div class="modal fade" id="applyLeaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Apply for Leave</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Leave Type <span class="text-danger">*</span></label>
                    <select id="alType" class="form-select"></select>
                    <div class="small text-muted mt-1" id="alBalanceHint"></div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">From <span class="text-danger">*</span></label>
                        <input type="date" id="alFrom" class="form-control">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">To <span class="text-danger">*</span></label>
                        <input type="date" id="alTo" class="form-control">
                    </div>
                </div>
                <div class="small text-muted mb-3" id="alDaysHint">
                    Days are counted inclusive of both dates. Weekends and holidays inside the
                    range are <strong>not</strong> excluded.
                </div>
                <div class="mb-0">
                    <label class="form-label fw-semibold small">Reason <span class="text-danger">*</span></label>
                    <textarea id="alReason" class="form-control" rows="3" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm px-4" onclick="submitApplyLeave()">Submit Request</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/me/my-leave.js" asp-append-version="true"></script>
}
