@{
    ViewData["Title"] = "Holidays";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Holiday Management</h5>
    <div class="d-flex gap-2">
        <select id="yearFilter" class="form-select form-select-sm" onchange="loadHolidays()" style="width:100px"></select>
        <button class="btn btn-primary btn-sm" onclick="openModal()">+ Add Holiday</button>
    </div>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-list" role="tab">
        <i class="feather icon-list me-1"></i>Holiday Master</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-calendar" role="tab"
                            onclick="renderCalendar()">
        <i class="feather icon-calendar me-1"></i>Calendar</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-list" role="tabpanel">
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive"><table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Name</th><th>Date</th><th>Day</th><th>Type</th><th>Recurring</th><th>Description</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="tbody">
                        <tr><td colspan="8" class="text-center py-3 text-muted">Loading...</td></tr>
                    </tbody>
                </table></div>
            </div>
        </div>
    </div>

    @* ── Calendar ────────────────────────────────────────────────────────────
       Twelve month grids for the selected year. A list of dates does not answer
       the question people actually bring to this screen — "is that week clear?"
       — and it hides the one thing worth spotting: a holiday landing on a day
       that is already a weekly off, so nobody gains a day from it. *@
    <div class="tab-pane fade" id="tab-calendar" role="tabpanel">
        <div class="d-flex flex-wrap gap-3 mb-3 small">
            <span><span class="hol-key hol-public"></span> Public</span>
            <span><span class="hol-key hol-company"></span> Company</span>
            <span><span class="hol-key hol-special"></span> Special</span>
            <span><span class="hol-key hol-projected"></span> Recurring, carried forward</span>
            <span><span class="hol-key hol-weekend"></span> Weekend</span>
        </div>
        <div class="row g-3" id="calendarGrid"></div>
    </div>
</div>

<style>
    .hol-key { display:inline-block; width:12px; height:12px; border-radius:3px;
               vertical-align:-1px; margin-right:.25rem; }
    .hol-public    { background:#0d6efd; }
    .hol-company   { background:#198754; }
    .hol-special   { background:#d63384; }
    .hol-projected { background:#0d6efd; opacity:.45; }
    .hol-weekend   { background:#e9ecef; }

    .hol-month table { width:100%; table-layout:fixed; }
    .hol-month th { font-size:.68rem; font-weight:600; color:#8b98a5; text-align:center; padding:.2rem 0; }
    .hol-month td { text-align:center; padding:.15rem 0; font-size:.76rem; }
    .hol-day { display:inline-flex; align-items:center; justify-content:center;
               width:26px; height:26px; border-radius:50%; }
    .hol-day.is-weekend  { background:#f1f3f5; color:#8b98a5; }
    .hol-day.is-holiday  { color:#fff; font-weight:600; }
    .hol-day.t-1 { background:#0d6efd; }
    .hol-day.t-2 { background:#198754; }
    .hol-day.t-3 { background:#d63384; }
    .hol-day.is-projected { opacity:.55; }
    .hol-day.is-today { box-shadow:0 0 0 2px #ffc107; }
</style>

<!-- Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="modalTitle">Add Holiday</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="itemId">
                <div class="mb-3"><label class="form-label">Name <span class="text-danger">*</span></label><input type="text" id="itemName" class="form-control" maxlength="200"></div>
                <div class="row g-2">
                    <div class="col-md-6 mb-2"><label class="form-label">Date <span class="text-danger">*</span></label><input type="date" id="itemDate" class="form-control"></div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Type</label>
                        @* Values must match HolidayType: Public=1, Company=2, Special=3.
                           They previously read 0/1/2/3 against labels Public/National/
                           Optional/Religious, so every saved holiday was stored as the type
                           *above* the one chosen, and "Public" saved an undefined 0. *@
                        <select id="itemType" class="form-select" data-no-search>
                            <option value="1">Public</option>
                            <option value="2">Company</option>
                            <option value="3">Special</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3"><label class="form-label">Description</label><textarea id="itemDesc" class="form-control" rows="2" maxlength="500"></textarea></div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="itemRecurring">
                    <label class="form-check-label" for="itemRecurring">Recurring every year</label>
                    <div class="small text-muted">
                        For holidays on a fixed date — 1 January, 25 December. Leave it off for
                        Poya, Eid and Deepavali, which move each year and need their own entry.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveItem()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/holidays.js" asp-append-version="true"></script>
}
