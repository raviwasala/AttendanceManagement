@{
    ViewData["Title"] = "Holidays";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Holiday Management</h5>
    <div class="d-flex gap-2">
        <select id="yearFilter" class="form-select form-select-sm" onchange="loadHolidays()" style="width:100px"></select>
        <button class="btn btn-primary btn-sm" onclick="openModal()">+ Add Holiday</button>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive"><table class="table table-hover table-sm mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Name</th><th>Date</th><th>Day</th><th>Type</th><th>Recurring</th><th>Description</th><th>Actions</th></tr>
            </thead>
            <tbody id="tbody">
                <tr><td colspan="8" class="text-center py-3 text-muted">Loading...</td></tr>
            </tbody>
        </table></div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="modalTitle">Add Holiday</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="itemId">
                <div class="mb-3"><label class="form-label">Name <span class="text-danger">*</span></label><input type="text" id="itemName" class="form-control" maxlength="200"></div>
                <div class="row g-2">
                    <div class="col-md-6 mb-2"><label class="form-label">Date <span class="text-danger">*</span></label><input type="date" id="itemDate" class="form-control"></div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Type</label>
                        <select id="itemType" class="form-select">
                            <option value="0">Public</option>
                            <option value="1">National</option>
                            <option value="2">Optional</option>
                            <option value="3">Religious</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3"><label class="form-label">Description</label><textarea id="itemDesc" class="form-control" rows="2" maxlength="500"></textarea></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="itemRecurring"><label class="form-check-label">Recurring every year</label></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveItem()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/holidays.js" asp-append-version="true"></script>
}
