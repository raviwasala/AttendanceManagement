@{
    ViewData["Title"] = "Leave Management";
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabRequests">Leave Requests</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabTypes">Leave Types</a></li>
</ul>

<div class="tab-content">

    <!-- Leave Requests -->
    <div class="tab-pane fade show active" id="tabRequests">
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <select id="reqStatusFilter" class="form-select form-select-sm" onchange="filterRequests()">
                            <option value="">All Status</option>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <input type="text" id="reqSearch" class="form-control form-select-sm" placeholder="Search employee..." oninput="filterRequests()">
                    </div>
                    <div class="col-md-auto ms-auto">
                        <button class="btn btn-primary btn-sm" onclick="openApplyModal()">+ Apply Leave</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive"><table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Employee</th><th>Department</th><th>Leave Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="reqBody">
                        <tr><td colspan="9" class="text-center py-3 text-muted">Loading...</td></tr>
                    </tbody>
                </table></div>
            </div>
        </div>
    </div>

    <!-- Leave Types -->
    <div class="tab-pane fade" id="tabTypes">
        <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-primary btn-sm" onclick="openTypeModal()">+ Add Leave Type</button>
        </div>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive"><table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Name</th><th>Total Days</th><th>Paid</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="typeBody">
                        <tr><td colspan="6" class="text-center py-3 text-muted">Loading...</td></tr>
                    </tbody>
                </table></div>
            </div>
        </div>
    </div>

</div>

<!-- Apply Leave Modal -->
<div class="modal fade" id="applyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Apply Leave</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Employee <span class="text-danger">*</span></label><select id="leaveEmp" class="form-select"></select></div>
                <div class="mb-3"><label class="form-label">Leave Type <span class="text-danger">*</span></label><select id="leaveType" class="form-select"></select></div>
                <div class="row g-2">
                    <div class="col-md-6 mb-2"><label class="form-label">From Date <span class="text-danger">*</span></label><input type="date" id="leaveFrom" class="form-control"></div>
                    <div class="col-md-6 mb-2"><label class="form-label">To Date <span class="text-danger">*</span></label><input type="date" id="leaveTo" class="form-control"></div>
                </div>
                <div class="mb-3"><label class="form-label">Reason <span class="text-danger">*</span></label><textarea id="leaveReason" class="form-control" rows="2" maxlength="1000"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="applyLeave()">Apply</button>
            </div>
        </div>
    </div>
</div>

<!-- Leave Type Modal -->
<div class="modal fade" id="typeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="typeModalTitle">Add Leave Type</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="typeId">
                <div class="mb-3"><label class="form-label">Name <span class="text-danger">*</span></label><input type="text" id="typeName" class="form-control" maxlength="100"></div>
                <div class="mb-3"><label class="form-label">Total Days <span class="text-danger">*</span></label><input type="number" id="typeDays" class="form-control" min="1" max="365" value="10"></div>
                <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="typePaid" checked><label class="form-check-label">Paid Leave</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="typeActive" checked><label class="form-check-label">Active</label></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveType()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/leave.js" asp-append-version="true"></script>
}

