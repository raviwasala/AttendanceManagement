@{
    ViewData["Title"] = "Dashboard";

    // Each tile links to the screen that explains its number, pre-filtered where the target
    // page supports it. A tile is only a link when the user may open the destination —
    // otherwise it renders as a plain tile, so nobody is invited into an Access Denied page.
    var tiles = new[]
    {
        new {
            Label = "Total Employees", ValueId = "statTotal",
            Icon = "icon-users",       Colour = "bg-c-yellow",
            Module = AppConstants.Modules.Employees,
            // ?? "" keeps every tile's Href the same non-nullable type. Without it this first
            // entry types the anonymous array as string? while the concatenated ones below are
            // string, which the compiler reports as a mismatch on each of them.
            Href = Url.Action("Employees", "Admin") ?? "",
            Hint = "View all employees"
        },
        new {
            Label = "Present Today",   ValueId = "statPresent",
            Icon = "icon-user-check",  Colour = "bg-c-green",
            Module = AppConstants.Modules.Attendance,
            // CheckedIn, not Present: the dashboard counts Present + Late as "present today",
            // so a plain Present filter would show fewer people than the tile's number.
            Href = Url.Action("Attendance", "Admin") + "?status=CheckedIn",
            Hint = "View everyone who checked in today"
        },
        new {
            Label = "Absent Today",    ValueId = "statAbsent",
            Icon = "icon-user-x",      Colour = "bg-c-pink",
            Module = AppConstants.Modules.Attendance,
            Href = Url.Action("Attendance", "Admin") + "?status=Absent",
            Hint = "View today's absent records"
        },
        new {
            Label = "On Leave Today",  ValueId = "statLeave",
            Icon = "icon-calendar",    Colour = "bg-c-blue",
            Module = AppConstants.Modules.Leave,
            Href = Url.Action("Leave", "Admin") + "?status=Approved",
            Hint = "View approved leave requests"
        }
    };
}

@{
    var canSetDashboardDefault = ViewContext.HasPermission(
        AppConstants.Modules.Settings, AppConstants.Actions.Edit);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0">Dashboard</h5>
    <div class="d-flex align-items-center gap-3">
        <span class="text-muted small">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
        <button class="btn btn-outline-secondary btn-sm px-3" onclick="openCustomise()">
            <i class="feather icon-sliders me-1"></i>Customise
        </button>
    </div>
</div>

@* ── Customise ───────────────────────────────────────────────────────────────
   Only widgets this user is permitted to load are listed. Offering one they
   cannot open would be a setting that does nothing, and the data endpoints keep
   their own permission checks regardless — hiding a widget is a preference, not
   a security boundary. *@
<div class="modal fade" id="customiseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Customise dashboard</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">
                    Choose what appears on <strong>your</strong> dashboard. This changes nothing
                    for anyone else.
                </p>
                <div id="cuList"><div class="text-muted small">Loading…</div></div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button class="btn btn-link btn-sm text-muted p-0" onclick="resetCustomise()">
                    Reset to default
                </button>
                <div class="d-flex gap-2">
                    @if (canSetDashboardDefault)
                    {
                        <button class="btn btn-outline-secondary btn-sm px-3" onclick="saveAsDefault()"
                                title="New users will start with this selection">
                            Save as company default
                        </button>
                    }
                    <button class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary btn-sm px-4" onclick="saveCustomise()">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards -->
@* Gradient classes (bg-c-yellow / green / pink / blue) come from the Adminty theme rather
   than being redefined here, so these tiles stay in step with the rest of the template. *@
<div class="row g-3 mb-4" id="statCards" data-widget="stats">
    @foreach (var t in tiles)
    {
        var canOpen = ViewContext.HasPermission(t.Module, AppConstants.Actions.View);
        <div class="col-xl-3 col-md-6">
            @if (canOpen)
            {
                <a href="@t.Href" class="stat-card-link" title="@t.Hint" aria-label="@t.Label — @t.Hint">
                    <div class="card stat-card @t.Colour">
                        <div class="card-body stat-card-body">
                            <div class="stat-card-text">
                                <p class="stat-card-label">@t.Label</p>
                                <h3 class="stat-card-value" id="@t.ValueId">—</h3>
                            </div>
                            <i class="feather @t.Icon stat-card-icon" aria-hidden="true"></i>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <div class="card stat-card @t.Colour">
                    <div class="card-body stat-card-body">
                        <div class="stat-card-text">
                            <p class="stat-card-label">@t.Label</p>
                            <h3 class="stat-card-value" id="@t.ValueId">—</h3>
                        </div>
                        <i class="feather @t.Icon stat-card-icon" aria-hidden="true"></i>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── Attendance trend ─────────────────────────────────────────────────────────
   Each analytics panel is gated on the module whose data it exposes, because the
   dashboard itself is visible to roles that cannot see attendance or leave. *@
@if (ViewContext.HasPermission(AppConstants.Modules.Attendance, AppConstants.Actions.View))
{
    @* data-widget marks a block the user can switch off in Customise. The permission gate
       above still applies first — a hidden widget is a preference, not a security boundary. *@
    <div class="row g-3 mb-3" data-widget="trend">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong>Attendance Trend</strong>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted" id="trendAvg"></span>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Trend range">
                            <button type="button" class="btn btn-outline-primary active" id="trendBtn7"
                                    onclick="loadTrend(7)">7 days</button>
                            <button type="button" class="btn btn-outline-primary" id="trendBtn30"
                                    onclick="loadTrend(30)">30 days</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="trendWarning" class="alert alert-warning py-2 small d-none" role="status"></div>
                    <div style="position:relative;height:260px;">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

@* ── Punctuality ────────────────────────────────────────────────────────────
   Requires Employees.View rather than Attendance.View: this names individuals and
   ranks them by lateness, which is HR territory. The Employee role holds
   Attendance.View so staff can see their own records — that must not also reveal
   a leaderboard of their colleagues. *@
@if (ViewContext.HasPermission(AppConstants.Modules.Employees, AppConstants.Actions.View))
{
    <div class="row g-3 mb-3">
        <div class="col-xl-5" data-widget="punctuality">
            <div class="card h-100">
                <div class="card-header"><strong>Punctuality</strong>
                    <span class="text-muted small ms-1">last 30 days</span>
                </div>
                <div class="card-body">
                    <div class="row text-center g-2 mb-3">
                        <div class="col-4">
                            <div class="fw-bold fs-5" id="punLatePct">—</div>
                            <div class="text-muted small">Late arrivals</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold fs-5" id="punAvgMins">—</div>
                            <div class="text-muted small">Avg late</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold fs-5" id="punEarly">—</div>
                            <div class="text-muted small">Early leave</div>
                        </div>
                    </div>
                    <div style="position:relative;height:170px;">
                        <canvas id="weekdayChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-7" data-widget="toplate">
            <div class="card h-100">
                <div class="card-header"><strong>Most Late Arrivals</strong>
                    <span class="text-muted small ms-1">last 30 days</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Employee</th>
                                    <th>Department</th>
                                    <th class="text-end">Times late</th>
                                    <th class="text-end">Avg mins</th>
                                    <th class="text-end pe-3">Total mins</th>
                                </tr>
                            </thead>
                            <tbody id="topLateBody">
                                <tr><td colspan="5" class="text-center py-3 text-muted">Loading…</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ── Leave overview ─────────────────────────────────────────────────────────── *@
@if (ViewContext.HasPermission(AppConstants.Modules.Leave, AppConstants.Actions.View))
{
    <div class="row g-3 mb-3">
        <div class="col-xl-7" data-widget="pendingleave">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Pending Leave Approvals</strong>
                    <a asp-controller="Admin" asp-action="Leave" class="btn btn-sm btn-outline-primary">Open Leave</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Employee</th>
                                    <th>Type</th>
                                    <th>Dates</th>
                                    <th class="text-end pe-3">Days</th>
                                </tr>
                            </thead>
                            <tbody id="pendingLeaveBody">
                                <tr><td colspan="4" class="text-center py-3 text-muted">Loading…</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-5" data-widget="leaveutil">
            <div class="card h-100">
                <div class="card-header"><strong>Leave Utilisation</strong>
                    <span class="text-muted small ms-1">this year</span>
                </div>
                <div class="card-body" id="leaveUtilBody">
                    <div class="text-muted small">Loading…</div>
                </div>
            </div>
        </div>
    </div>
}

@* ── Operations health ──────────────────────────────────────────────────────── *@
@if (ViewContext.HasPermission(AppConstants.Modules.Employees, AppConstants.Actions.View))
{
    <div class="row g-3 mb-3" data-widget="datahealth">
        <div class="col-12">
            <div class="card">
                <div class="card-header"><strong>Data Health</strong>
                    <span class="text-muted small ms-1">issues that silently distort attendance</span>
                </div>
                <div class="card-body" id="opsBody">
                    <div class="text-muted small">Loading…</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3" data-widget="quicklinks">
    <!-- Attendance % card -->
    <div class="col-xl-4 col-md-6">
        <div class="card h-100">
            <div class="card-header"><strong>Today's Attendance</strong></div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position:relative;width:160px;height:160px;">
                    <canvas id="attendancePie"></canvas>
                    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center">
                        <span class="fw-bold fs-4" id="pctLabel">—</span>
                        <div class="text-muted small">Attendance</div>
                    </div>
                </div>
                <div class="mt-3 w-100">
                    <div class="d-flex justify-content-between small mb-1">
                        <span><span class="badge bg-success me-1">&nbsp;</span>Present</span>
                        <span id="lblPresent">—</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span><span class="badge bg-danger me-1">&nbsp;</span>Absent</span>
                        <span id="lblAbsent">—</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span><span class="badge bg-warning me-1">&nbsp;</span>Late</span>
                        <span id="lblLate">—</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span><span class="badge bg-info me-1">&nbsp;</span>On Leave</span>
                        <span id="lblLeave">—</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent attendance table -->
    <div class="col-xl-8 col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Recent Attendance</strong>
                <a asp-controller="Admin" asp-action="Attendance" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Date</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="recentBody">
                            <tr><td colspan="5" class="text-center py-3 text-muted">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><strong>Quick Links</strong></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Admin" asp-action="Employees"    class="btn btn-outline-primary btn-sm"><i class="feather icon-users me-1"></i>Employees</a>
                    <a asp-controller="Admin" asp-action="Attendance"   class="btn btn-outline-success btn-sm"><i class="feather icon-clock me-1"></i>Attendance</a>
                    <a asp-controller="Admin" asp-action="Leave"        class="btn btn-outline-warning btn-sm"><i class="feather icon-calendar me-1"></i>Leave</a>
                    <a asp-controller="Admin" asp-action="Departments"  class="btn btn-outline-secondary btn-sm"><i class="feather icon-grid me-1"></i>Departments</a>
                    <a asp-controller="Admin" asp-action="Shifts"       class="btn btn-outline-info btn-sm"><i class="feather icon-watch me-1"></i>Shifts</a>
                    <a asp-controller="Admin" asp-action="Reports"      class="btn btn-outline-dark btn-sm"><i class="feather icon-bar-chart-2 me-1"></i>Reports</a>
                    <a asp-controller="Admin" asp-action="Users"        class="btn btn-outline-danger btn-sm"><i class="feather icon-user me-1"></i>Users</a>
                    <a asp-controller="Admin" asp-action="Settings"     class="btn btn-outline-secondary btn-sm"><i class="feather icon-settings me-1"></i>Settings</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/pages/admin/dashboard.js" asp-append-version="true"></script>
}

