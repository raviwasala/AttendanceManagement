@{
    ViewData["Title"] = "OT Register";
    var canExport = ViewContext.HasPermission(AppConstants.Modules.Overtime, AppConstants.Actions.Export);
    var today = DateTime.Today;
    var monthStart = new DateTime(today.Year, today.Month, 1);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-1">Overtime Register</h5>
        <p class="text-muted small mb-0">Every claim, whatever its state — the day-by-day record</p>
    </div>
    @if (canExport)
    {
        <button class="btn btn-outline-primary btn-sm px-3" onclick="exportRegister()">
            <i class="feather icon-download me-1"></i>Export CSV
        </button>
    }
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">From</label>
                <input type="date" id="regFrom" class="form-control form-control-sm" value="@monthStart.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">To</label>
                <input type="date" id="regTo" class="form-control form-control-sm" value="@today.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Department</label>
                <select id="regDept" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Employee</label>
                <select id="regEmployee" class="form-select form-select-sm">
                    <option value="">All Employees</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Status</label>
                <select id="regStatus" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="1">Pending</option>
                    <option value="2">Approved</option>
                    <option value="3">Rejected</option>
                </select>
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary btn-sm w-100" onclick="loadRegister()">
                    <i class="feather icon-search"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row g-2 mb-3" id="regStats"></div>

<div class="card card-table-container">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Date</th>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Shift</th>
                        <th class="text-center">In / Out</th>
                        <th class="text-center">Day</th>
                        <th class="text-center">Claimed</th>
                        <th class="text-center">Approved</th>
                        <th class="text-center">Rate</th>
                        <th class="text-center">Weighted</th>
                        <th>Status</th>
                        <th class="pe-3">Decided By</th>
                    </tr>
                </thead>
                <tbody id="regBody">
                    <tr><td colspan="12" class="text-center py-4 text-muted">Loading…</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/overtime-register.js" asp-append-version="true"></script>
}
