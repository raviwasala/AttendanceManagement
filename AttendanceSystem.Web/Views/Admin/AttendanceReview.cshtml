@{
    ViewData["Title"] = "Attendance Review";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-1">Attendance Review</h5>
        <p class="text-muted small mb-0">Rostered shift against what the device recorded — correct in/out times here</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-1">From</label>
                <input type="date" id="arFrom" class="form-control form-control-sm">
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">To</label>
                <input type="date" id="arTo" class="form-control form-control-sm">
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Employee</label>
                <select id="arEmployee" class="form-select form-select-sm" style="min-width:200px;">
                    <option value="">All Employees</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Department</label>
                <select id="arDept" class="form-select form-select-sm" style="min-width:150px;">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Show</label>
                @* Values match the filter names the API understands. The stat tiles set this
                   same control, so the dropdown always reflects what is on screen. *@
                <select id="arFilter" class="form-select form-select-sm" style="min-width:150px;">
                    <option value="">All rows</option>
                    <option value="exceptions">Needs attention</option>
                    <option value="recorded">Has a record</option>
                    <option value="present">Present only</option>
                    <option value="late">Late only</option>
                    <option value="absent">Absent only</option>
                    <option value="onleave">On leave only</option>
                    <option value="nocheckout">Missing check-out</option>
                    <option value="overtime">Has overtime</option>
                    <option value="overlate">Over late allowance</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm px-3" onclick="loadReview()">
                    <i class="feather icon-refresh-cw me-1"></i>Load
                </button>
            </div>
            @* Recalculating and locking act on the range above, so they live beside it. *@
            @if (ViewContext.HasPermission(AppConstants.Modules.Attendance, AppConstants.Actions.Edit))
            {
                <div class="col-auto">
                    <button class="btn btn-outline-secondary btn-sm px-3" onclick="openReprocess()"
                            title="Recalculate this range against current shift settings">
                        <i class="feather icon-repeat me-1"></i>Reprocess
                    </button>
                </div>
            }
            @if (ViewContext.HasPermission(AppConstants.Modules.Attendance, AppConstants.Actions.Delete))
            {
                <div class="col-auto">
                    <button class="btn btn-outline-secondary btn-sm px-3" onclick="openLocks()"
                            title="Close a period so it cannot be edited or re-imported">
                        <i class="feather icon-lock me-1"></i>Periods
                    </button>
                </div>
            }
        </div>

        @* Presets cover the cases people actually ask for, without date arithmetic. *@
        <div class="d-flex gap-1 mt-2 flex-wrap">
            <button class="btn btn-link btn-sm p-0 me-2" onclick="preset('today')">Today</button>
            <button class="btn btn-link btn-sm p-0 me-2" onclick="preset('yesterday')">Yesterday</button>
            <button class="btn btn-link btn-sm p-0 me-2" onclick="preset('thisweek')">This week</button>
            <button class="btn btn-link btn-sm p-0 me-2" onclick="preset('thismonth')">This month</button>
            <button class="btn btn-link btn-sm p-0 me-2" onclick="preset('lastmonth')">Last month</button>
            <span class="text-muted small ms-2" id="arRangeLabel"></span>
        </div>
    </div>
</div>

<div class="row g-2 mb-3" id="arSummary"></div>

<div class="card card-table-container">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 ar-date-col">Date</th>
                        <th class="ar-emp-col">Employee</th>
                        <th>Rostered Shift</th>
                        <th class="text-center">Expected</th>
                        <th class="text-center">In</th>
                        <th class="text-center">Out</th>
                        @* One column, not two. Late and early leave are mutually rare on the
                           same row, so two columns spent most of their width showing a dash
                           each while the time inputs beside them were cramped. *@
                        <th class="text-center">Late / Early</th>
                        <th class="text-center">Hours</th>
                        <th class="text-center">OT</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Save</th>
                    </tr>
                </thead>
                <tbody id="arBody">
                    <tr><td colspan="12" class="text-center py-4 text-muted">Choose a range and press Load.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="small text-muted mt-2">
    Edit a time and press <strong>Save</strong> on that row. Late, early leave, working hours and
    status are recalculated from the employee's shift for that date. Clearing both times removes
    the record.
</div>

@section Styles {
    <style>
        /* Tiles that filter behave like buttons; the active one is pulled forward with a ring
           so it is obvious the table below is showing a subset rather than everything. */
        .ar-tile { cursor: pointer; transition: transform .12s ease, box-shadow .12s ease; }
        .ar-tile:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.16); }
        .ar-tile-on {
            outline: 3px solid rgba(255,255,255,.85);
            outline-offset: -3px;
            box-shadow: 0 6px 18px rgba(0,0,0,.22);
        }

        /* 92px left no room for the value and the browser's clock button together, so the
           digits sat hard against the edge and "--:--" was clipped. The width the merged
           Late/Early column gave back pays for this. */
        .ar-time {
            width: 118px;
            min-width: 118px;
            text-align: center;
            font-variant-numeric: tabular-nums;
            padding-left: .35rem;
            padding-right: .35rem;
        }

        /* Wide enough for "Late 15m" and "Early 20m" without either wrapping mid-badge. */
        .ar-flag-col { min-width: 92px; }
        .ar-flag-col .badge { display: inline-block; }
        .ar-dirty { background: #fff9db !important; }
        .ar-row-noshift { background: #fff5f5; }
    </style>
}

@* ── Reprocess ───────────────────────────────────────────────────────────── *@
<div class="modal fade" id="reprocessModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Reprocess Attendance</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p class="small text-muted">
                    Recalculates lateness, hours and overtime for
                    <strong id="rpRange"></strong> from the times already recorded, using the
                    shift settings as they are <em>now</em>.
                </p>
                <div class="alert alert-light border py-2 small">
                    Use this after correcting a shift — grace minutes, break, overtime rules.
                    Changing a shift does not update days already calculated against the old
                    settings. The punch times themselves are never altered.
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rpIncludeManual">
                    <label class="form-check-label small" for="rpIncludeManual">
                        Also recalculate manually corrected records
                    </label>
                    <div class="small text-muted">
                        Off by default. A manual correction is somebody's decision about a
                        specific day, and this would overwrite it.
                    </div>
                </div>
                <div id="rpResult" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-primary btn-sm px-4" onclick="submitReprocess()">Reprocess</button>
            </div>
        </div>
    </div>
</div>

@* ── Locked periods ──────────────────────────────────────────────────────── *@
<div class="modal fade" id="lockModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Locked Periods</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="alert alert-light border py-2 small">
                    A locked period cannot be edited on this screen and will not be overwritten
                    by a biometric import. Lock a month once payroll has been paid.
                </div>

                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-3">
                        <label class="form-label small mb-1">From</label>
                        <input type="date" id="lkFrom" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">To</label>
                        <input type="date" id="lkTo" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Branch</label>
                        <select id="lkBranch" class="form-select form-select-sm">
                            <option value="">All branches</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Reason</label>
                        <input type="text" id="lkReason" class="form-control form-control-sm"
                               maxlength="300" placeholder="e.g. March payroll paid">
                    </div>
                </div>
                <button class="btn btn-primary btn-sm px-3 mb-3" onclick="submitLock()">
                    <i class="feather icon-lock me-1"></i>Lock this period
                </button>

                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Period</th><th>Branch</th>
                                <th class="text-end">Records</th><th>Reason</th>
                                <th class="pe-3 text-center" style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="lockBody">
                            <tr><td colspan="5" class="text-center py-3 text-muted">Loading…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.reviewPerms = {
            edit: @Json.Serialize(ViewContext.HasPermission(AppConstants.Modules.Attendance, AppConstants.Actions.Edit)),
            lock: @Json.Serialize(ViewContext.HasPermission(AppConstants.Modules.Attendance, AppConstants.Actions.Delete))
        };
    </script>
    <script src="~/js/pages/admin/attendance-review.js" asp-append-version="true"></script>
}
