@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Department Management</h4>
        <p class="text-muted small mb-0">Organize and manage organizational departments</p>
    </div>
    <button class="btn btn-primary btn-sm px-3 rounded-2 shadow-sm" onclick="openModal()">
        <i class="feather icon-plus me-1"></i>Add Department
    </button>
</div>

<div class="card card-table-container mb-4">
    <div class="card-body p-3">
        <div class="row g-2">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="feather icon-search"></i></span>
                    <input type="text" id="searchBox" class="form-control form-control-sm border-start-0" placeholder="Search departments..." oninput="filterTable()">
                </div>
            </div>
            <div class="col-md-3">
                <select id="statusFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All Statuses</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card card-table-container">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-custom mb-0" id="deptTable">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Department Name</th>
                        <th>Description</th>
                        <th>Employees</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="deptBody">
                    <tr><td colspan="6" class="text-center py-4 text-muted">Loading departments...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="deptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-light border-bottom-0 py-3">
                <h6 class="modal-title fw-bold" id="modalTitle">Add Department</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="deptId">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Department Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="feather icon-grid"></i></span>
                        <input type="text" id="deptName" class="form-control" maxlength="200" placeholder="e.g. Information Technology">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Description</label>
                    <textarea id="deptDesc" class="form-control" rows="3" maxlength="500" placeholder="Department summary..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Department Head</label>
                    <select id="deptHead" class="form-select">
                        <option value="">Not set</option>
                    </select>
                    @* The head is a fact about the organisation; whether they can act on it
                       additionally needs a login and Leave.Approve. Saying so stops "I made
                       him head but he still cannot approve" being a mystery. *@
                    <div class="form-text small">
                        Heading a department also allows approving its leave and overtime —
                        provided this person has a login with approval permission.
                    </div>
                </div>

                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" id="deptActive" checked>
                    <label class="form-check-label fw-medium" for="deptActive">Active Status</label>
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 py-3">
                <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm px-4" onclick="saveDept()">Save Department</button>
            </div>
        </div>
    </div>
</div>

@* ── Approvers ───────────────────────────────────────────────────────────────
   Separate from the department form on purpose: editing a department is routine,
   while changing who may approve its leave is a permission decision. Keeping them
   apart makes the second one deliberate. *@
<div class="modal fade" id="approverModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Approvers — <span id="apDeptName"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @* The HR-manager case is the one people get wrong, so it is spelled out.
                   Adding somebody here *narrows* them, so a company-wide approver should be
                   left out rather than added — they already cover every department. *@
                <div class="alert alert-light border py-2 small mb-3">
                    <i class="feather icon-info me-1"></i>
                    A department can have <strong>as many approvers as you like</strong> — a
                    head and a supervisor, or two supervisors sharing the duty.
                    <div class="mt-1">
                        Anyone who already approves for the whole company — an HR Manager, an
                        administrator — <strong>should not be added here</strong>. They can
                        already decide this department's requests, and naming them would
                        restrict them to it.
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold">Add approvers</label>
                    <select id="apUser" class="form-select form-select-sm" multiple size="6"></select>
                    <div class="form-text small">Hold Ctrl (or Cmd) to pick several at once.</div>
                </div>
                <button class="btn btn-primary btn-sm px-3 mb-3" onclick="addApprover()">
                    <i class="feather icon-plus me-1"></i>Add selected
                </button>

                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th class="ps-3">User</th><th>Username</th>
                                <th class="pe-3 text-center" style="width:70px;">Remove</th></tr>
                        </thead>
                        <tbody id="apBody">
                            <tr><td colspan="3" class="text-center py-3 text-muted">Loading…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/departments.js" asp-append-version="true"></script>
}
