@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Employee Management</h4>
        <p class="text-muted small mb-0">Manage personnel, designations, departments, and active statuses</p>
    </div>
    <button class="btn btn-primary btn-sm px-3 rounded-2 shadow-sm" onclick="openModal()">
        <i class="feather icon-user-plus me-1"></i>Add Employee
    </button>
</div>

<!-- Filters -->
<div class="card card-table-container mb-4">
    <div class="card-body p-3">
        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="feather icon-search"></i></span>
                    @* No oninput here: search now hits the database, so the page script
                       debounces it rather than firing a request per keystroke. *@
                    <input type="search" id="searchBox" class="form-control form-control-sm border-start-0"
                           placeholder="Search name/code/email/phone..." autocomplete="off">
                </div>
            </div>
            <div class="col-md-3">
                <select id="deptFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="statusFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All Statuses</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card card-table-container">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-custom mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Branch</th>
                        <th>Enroll ID</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="empBody">
                    <tr><td colspan="8" class="text-center py-4 text-muted">Loading employees...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Employee Modal -->
<div class="modal fade" id="empModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-light border-bottom-0 py-3">
                <h6 class="modal-title fw-bold" id="empModalTitle">Add Employee</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="empId">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Employee Code</label>
                        <input type="text" id="empCode" class="form-control" placeholder="Auto-generated if blank">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">First Name <span class="text-danger">*</span></label>
                        <input type="text" id="empFirst" class="form-control" maxlength="100">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Last Name <span class="text-danger">*</span></label>
                        <input type="text" id="empLast" class="form-control" maxlength="100">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Department <span class="text-danger">*</span></label>
                        <select id="empDept" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Designation <span class="text-danger">*</span></label>
                        <select id="empDesig" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Branch <span class="text-danger">*</span></label>
                        <select id="empBranch" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Email</label>
                        <input type="email" id="empEmail" class="form-control" maxlength="200">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Phone</label>
                        <input type="text" id="empPhone" class="form-control" maxlength="20">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Gender</label>
                        <select id="empGender" class="form-select">
                            <option value="">Select</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Joining Date <span class="text-danger">*</span></label>
                        <input type="date" id="empJoin" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Date of Birth</label>
                        <input type="date" id="empDob" class="form-control">
                    </div>
                    <div class="col-md-4">
                        @* Without this the field is unreachable from the application, and every
                           biometric import silently matches nobody. *@
                        <label class="form-label fw-semibold small">Biometric Enroll ID</label>
                        <input type="number" id="empEnrollId" class="form-control" min="1"
                               placeholder="e.g. 1042">
                        <div class="form-text small">The ID this person is enrolled under on the fingerprint device.</div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold small">Address</label>
                        <textarea id="empAddr" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="empActive" checked>
                            <label class="form-check-label fw-medium" for="empActive">Active Status</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 py-3">
                <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm px-4" onclick="saveEmp()">Save Employee</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/employees.js" asp-append-version="true"></script>
}

