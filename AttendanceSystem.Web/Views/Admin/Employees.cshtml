@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Employee Management</h5>
    <button class="btn btn-primary btn-sm" onclick="openModal()">+ Add Employee</button>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" id="searchBox" class="form-control form-control-sm" placeholder="Search name/code/email..." oninput="filterTable()">
            </div>
            <div class="col-md-3">
                <select id="deptFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="statusFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover table-sm mb-0">
            <thead class="table-light">
                <tr><th>Code</th><th>Name</th><th>Department</th><th>Designation</th><th>Branch</th><th>Phone</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody id="empBody">
                <tr><td colspan="8" class="text-center py-3 text-muted">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Employee Modal -->
<div class="modal fade" id="empModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="empModalTitle">Add Employee</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="empId">
                <div class="row g-2">
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Employee Code</label>
                        <input type="text" id="empCode" class="form-control" placeholder="Auto-generated if blank">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">First Name <span class="text-danger">*</span></label>
                        <input type="text" id="empFirst" class="form-control" maxlength="100">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Last Name <span class="text-danger">*</span></label>
                        <input type="text" id="empLast" class="form-control" maxlength="100">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <select id="empDept" class="form-select"></select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Designation <span class="text-danger">*</span></label>
                        <select id="empDesig" class="form-select"></select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Branch <span class="text-danger">*</span></label>
                        <select id="empBranch" class="form-select"></select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Email</label>
                        <input type="email" id="empEmail" class="form-control" maxlength="200">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Phone</label>
                        <input type="text" id="empPhone" class="form-control" maxlength="20">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Gender</label>
                        <select id="empGender" class="form-select">
                            <option value="">Select</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Joining Date <span class="text-danger">*</span></label>
                        <input type="date" id="empJoin" class="form-control">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" id="empDob" class="form-control">
                    </div>
                    <div class="col-md-12 mb-2">
                        <label class="form-label">Address</label>
                        <textarea id="empAddr" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="empActive" checked>
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveEmp()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/employees.js" asp-append-version="true"></script>
}

