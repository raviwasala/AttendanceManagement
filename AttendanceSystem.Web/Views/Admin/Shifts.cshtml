@{
    ViewData["Title"] = "Shifts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Shift Management</h5>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="shiftTabs">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabShifts">Shift Definitions</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAssign">Employee Assignments</a></li>
</ul>

<div class="tab-content">

    <!-- Shift Definitions Tab -->
    <div class="tab-pane fade show active" id="tabShifts">
        <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-primary btn-sm" onclick="openShiftModal()">+ Add Shift</button>
        </div>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive"><table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Code</th><th>Name</th><th>Timing</th><th>Span</th><th>Grace In/Out</th><th>Break</th><th>Overtime</th><th>Weekly Off</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="shiftBody">
                        <tr><td colspan="8" class="text-center py-3 text-muted">Loading...</td></tr>
                    </tbody>
                </table></div>
            </div>
        </div>
    </div>

    <!-- Assignments Tab -->
    <div class="tab-pane fade" id="tabAssign">
        <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-success btn-sm" onclick="openAssignModal()">+ Assign Shift</button>
        </div>
        <div class="card mb-2">
            <div class="card-body py-2">
                <input type="text" id="assignSearch" class="form-control form-control-sm" placeholder="Search by employee..." oninput="filterAssign()">
            </div>
        </div>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive"><table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Code</th><th>Employee</th><th>Shift</th><th>Start</th><th>End</th><th>Effective From</th><th>Effective To</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="assignBody">
                        <tr><td colspan="8" class="text-center py-3 text-muted">Loading...</td></tr>
                    </tbody>
                </table></div>
            </div>
        </div>
    </div>

</div>

<!-- Shift Modal -->
<div class="modal fade" id="shiftModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="shiftModalTitle">Add Shift</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="shiftId">
                <div id="shiftError" class="alert alert-danger py-2 small d-none"></div>

                <div class="row g-2">
                    <div class="col-md-3 mb-2">
                        <label class="form-label small fw-semibold">Shift Code</label>
                        <input type="text" id="shiftCode" class="form-control" maxlength="20" placeholder="GEN">
                    </div>
                    <div class="col-md-9 mb-2">
                        <label class="form-label small fw-semibold">Name <span class="text-danger">*</span></label>
                        <input type="text" id="shiftName" class="form-control" maxlength="100">
                    </div>

                    <div class="col-md-6 mb-2">
                        <label class="form-label small fw-semibold">Start Time <span class="text-danger">*</span></label>
                        <input type="time" id="shiftStart" class="form-control" onchange="onShiftTimeChange()">
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label small fw-semibold">End Time <span class="text-danger">*</span></label>
                        <input type="time" id="shiftEnd" class="form-control" onchange="onShiftTimeChange()">
                    </div>

                    <div class="col-12 mb-2">
                        @* Ticked automatically when the times cross midnight — the flag and the
                           times must agree or the calculation goes wrong in a way nobody sees. *@
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="shiftNight" onchange="updateShiftSummary()">
                            <label class="form-check-label small" for="shiftNight">
                                Night shift <span class="text-muted">(runs past midnight)</span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6 mb-2">
                        <label class="form-label small fw-semibold">Grace In (min)</label>
                        <input type="number" id="shiftGrace" class="form-control" value="0" min="0" max="240">
                        <div class="form-text small">Late only after this.</div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label small fw-semibold">Grace Out (min)</label>
                        <input type="number" id="shiftGraceOut" class="form-control" value="0" min="0" max="240">
                        <div class="form-text small">Early leave only before this.</div>
                    </div>

                    <div class="col-md-6 mb-2">
                        <label class="form-label small fw-semibold">Break (min)</label>
                        <input type="number" id="shiftBreak" class="form-control" value="0" min="0" max="480"
                               onchange="updateShiftSummary()">
                        <div class="form-text small">Unpaid, deducted from worked time.</div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label small fw-semibold">Standard Working Hours</label>
                        <input type="number" id="shiftStdHours" class="form-control" value="0" min="0" max="24" step="0.25">
                        <div class="form-text small">Leave 0 to use span minus break.</div>
                    </div>

                    <div class="col-12"><hr class="my-2"></div>

                    <div class="col-12 mb-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="shiftOtEnabled" checked
                                   onchange="toggleOtFields()">
                            <label class="form-check-label small fw-semibold" for="shiftOtEnabled">Overtime enabled</label>
                        </div>
                    </div>

                    <div class="col-md-6 mb-2 ot-field">
                        <label class="form-label small fw-semibold">OT starts after (min)</label>
                        <input type="number" id="shiftOtAfter" class="form-control" value="0" min="0" max="480">
                        <div class="form-text small">Minutes past shift end before OT accrues.</div>
                    </div>
                    <div class="col-md-6 mb-2 ot-field">
                        <label class="form-label small fw-semibold">OT measured from</label>
                        <select id="shiftOtBasis" class="form-select">
                            <option value="true">Shift end time</option>
                            <option value="false">Standard working hours</option>
                        </select>
                    </div>

                    <div class="col-12"><hr class="my-2"></div>

                    <div class="col-md-8 mb-2">
                        <label class="form-label small fw-semibold">Weekly Off Days</label>
                        <input type="text" id="shiftWeeklyOff" class="form-control" value="Saturday,Sunday" placeholder="Saturday,Sunday">
                    </div>
                    <div class="col-md-4 mb-2 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="shiftActive" checked>
                            <label class="form-check-label small" for="shiftActive">Active</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-light border py-2 small mb-0" id="shiftSummary"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveShift()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Modal -->
<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Assign Shift to Employee</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Employee <span class="text-danger">*</span></label>
                    <select id="assignEmp" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Shift <span class="text-danger">*</span></label>
                    <select id="assignShift" class="form-select"></select>
                </div>
                <div class="row g-2">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Effective From <span class="text-danger">*</span></label>
                        <input type="date" id="assignFrom" class="form-control">
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Effective To</label>
                        <input type="date" id="assignTo" class="form-control">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success btn-sm" onclick="saveAssign()">Assign</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/shifts.js" asp-append-version="true"></script>
}

