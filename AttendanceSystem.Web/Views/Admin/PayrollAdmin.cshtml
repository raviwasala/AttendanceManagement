@{
    ViewData["Title"] = "Payroll Administration";
}

<div class="mb-3">
    <h5 class="mb-0">Payroll Administration</h5>
    <div class="text-muted small">Corrections and exceptions — adjustments, suspensions, code changes.</div>
</div>

<div id="paAlert"></div>

@* Three small screens on one page. Each is used rarely and none justifies its own sidebar
   entry, but together they are what a payroll clerk reaches for when something is wrong. *@
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#pa-epf">
        <i class="feather icon-percent me-1"></i>EPF Adjustments</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#pa-noneffective">
        <i class="feather icon-user-x me-1"></i>Non Effective Employees</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#pa-code">
        <i class="feather icon-hash me-1"></i>Change Employee Code</a></li>
</ul>

<div class="tab-content">

    <!-- ── EPF adjustments ── -->
    <div class="tab-pane fade show active" id="pa-epf" role="tabpanel">
        <div class="card">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <div><strong>EPF / ETF Adjustments</strong>
                    <div class="text-muted small">
                        Corrections to a past month. These change the payslip and, when flagged,
                        the statutory return.
                    </div></div>
                <button class="btn btn-primary btn-sm" onclick="paAdjustModal()">+ Add Adjustment</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive"><table class="table table-hover table-sm mb-0">
                    <thead class="table-light"><tr>
                        <th class="ps-3">Employee</th><th>Period</th><th>Contribution</th>
                        <th class="text-end">Amount</th><th>Reason</th>
                        <th class="text-center">Return</th><th class="text-center">Applied</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr></thead>
                    <tbody id="paAdjustBody"><tr><td colspan="8" class="text-center py-3 text-muted">Loading…</td></tr></tbody>
                </table></div>
            </div>
        </div>
    </div>

    <!-- ── Non effective ── -->
    <div class="tab-pane fade" id="pa-noneffective" role="tabpanel">
        <div class="card">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <div><strong>Employees Not Being Paid</strong>
                    <div class="text-muted small">
                        Suspended, resigned or inactive. Only a suspension can be lifted here.
                    </div></div>
                <button class="btn btn-primary btn-sm" onclick="paSuspendModal()">+ Suspend an Employee</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive"><table class="table table-hover table-sm mb-0">
                    <thead class="table-light"><tr>
                        <th class="ps-3">Code</th><th>Employee</th><th>Department</th>
                        <th>Category</th><th>Reason</th><th>From</th><th>To</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr></thead>
                    <tbody id="paNonEffBody"><tr><td colspan="8" class="text-center py-3 text-muted">Loading…</td></tr></tbody>
                </table></div>
            </div>
        </div>
    </div>

    <!-- ── Change code ── -->
    <div class="tab-pane fade" id="pa-code" role="tabpanel">
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-warning py-2 small">
                            <i class="feather icon-alert-triangle me-1"></i>
                            The employee code appears on payslips, exports and statutory returns.
                            Changing it does not rewrite documents already issued — the change is
                            recorded with the old code so earlier payslips can still be traced.
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">
                                Employee <span class="text-danger">*</span>
                            </label>
                            <select id="ccEmployee" class="form-select" onchange="paCodeSelected()"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Current Code</label>
                            <input type="text" id="ccCurrent" class="form-control" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">
                                New Code <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="ccNew" class="form-control" maxlength="50">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">
                                Reason <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="ccReason" class="form-control" maxlength="300"
                                   placeholder="e.g. renumbering after branch merge">
                        </div>

                        <button class="btn btn-primary" onclick="paChangeCode()">
                            <i class="feather icon-save me-1"></i>Change Code
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="paModalTitle">Edit</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"><div class="row g-2" id="paModalBody"></div></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="paModalSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/payroll-admin.js" asp-append-version="true"></script>
}
