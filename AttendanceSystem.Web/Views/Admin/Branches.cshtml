@{
    ViewData["Title"] = "Branches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Branch Management</h5>
    <button class="btn btn-primary btn-sm" onclick="openModal()">+ Add Branch</button>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" id="searchBox" class="form-control form-control-sm" placeholder="Search branches..." oninput="filterTable()">
            </div>
            <div class="col-md-3">
                <select id="statusFilter" class="form-select form-select-sm" onchange="filterTable()">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover table-sm mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Name</th><th>Address</th><th>Phone</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody id="tbody">
                <tr><td colspan="6" class="text-center py-3 text-muted">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="modalTitle">Add Branch</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="itemId">
                <div class="mb-3">
                    <label class="form-label">Name <span class="text-danger">*</span></label>
                    <input type="text" id="itemName" class="form-control" maxlength="200">
                </div>
                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <textarea id="itemAddr" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" id="itemPhone" class="form-control" maxlength="20">
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="itemActive" checked>
                    <label class="form-check-label">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveItem()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/branches.js" asp-append-version="true"></script>
}
