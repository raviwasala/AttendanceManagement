@{
    ViewData["Title"] = "Import Biometric Data";
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col-auto">
            <h5 class="page-title mb-0">Biometric Data Import</h5>
        </div>
        <div class="col-auto ms-auto">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Biometric Import</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- ── Left Column: Upload Controls ── -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center text-white" style="background:#01a9ac;">
                <h5 class="card-header-text text-white mb-0">
                    <i class="fa fa-upload me-2"></i>Upload File (CSV / Excel / MS Access)
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Biometric File <span class="text-danger">*</span></label>
                    <input type="file" id="importFile" class="form-control" accept=".csv,.xlsx,.xls,.mdb,.accdb">
                    <div class="form-text small text-muted">
                        Supported formats: <strong>CSV</strong> (.csv, .txt), <strong>Excel</strong> (.xlsx, .xls), and <strong>Microsoft Access Databases</strong> (.mdb, .accdb — ZKTeco / Att_log / CHECKINOUT tables).
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">From Date</label>
                        <input type="date" id="importFrom" class="form-control">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">To Date</label>
                        <input type="date" id="importTo" class="form-control">
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm px-3" id="btnPreview" onclick="previewFile()">
                        <i class="fa fa-eye me-1"></i>Preview Punches
                    </button>
                    <button class="btn text-white btn-sm px-3" style="background:#01a9ac;"
                            id="btnImport" onclick="importDirectFile()">
                        <i class="fa fa-download me-1"></i>Import Directly
                    </button>
                </div>

                @* ── Progress ────────────────────────────────────────────────
                   Upload percentage is real and worth showing: a 35 MB Access
                   file takes long enough that a static spinner looks like a
                   hang. Once it is on the server the work is one opaque call,
                   so the bar switches to indeterminate and an elapsed counter
                   carries the "still working" message instead of a fake number. *@
                <div id="importProgress" class="mt-3 d-none">
                    <div class="d-flex justify-content-between small mb-1">
                        <span id="ipLabel" class="text-muted">Preparing…</span>
                        <span id="ipElapsed" class="text-muted"></span>
                    </div>
                    <div class="progress" style="height:8px;">
                        <div id="ipBar" class="progress-bar" role="progressbar" style="width:0%"
                             aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="small text-muted mt-1" id="ipHint"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Right Column: Status & Summary ── -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header fw-semibold" style="background:#f8f9fa;">
                <i class="fa fa-info-circle me-1" style="color:#01a9ac;"></i>Import Summary &amp; Status
            </div>
            <div class="card-body">
                <div id="resultPanel" class="text-muted">
                    <p class="mb-0"><i class="fa fa-info-circle me-1"></i>Select a file and click <strong>Preview &amp; Edit</strong> to review and modify punch data before saving.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Preview ─────────────────────────────────────────────────────────────────
   Read-only. Editing punches here meant hand-correcting rows one at a time in a
   list that runs to tens of thousands — and an edited punch is no longer what the
   device recorded, which is the one thing a biometric record is for. Corrections
   belong on Attendance Review, where they are marked as manual and protected from
   being overwritten by the next import. *@
<div class="card mt-3" id="previewCard" style="display:none">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <span class="fw-semibold text-dark"><i class="fa fa-eye me-1" style="color:#01a9ac;"></i>Punch Preview</span>
            <span class="badge bg-secondary ms-2" id="previewCount">0 records</span>
            <small class="text-muted ms-2 d-block d-sm-inline">
                Read from the file, nothing saved yet. Showing the first
                <span id="previewShown">0</span>.
            </small>
        </div>
        <button class="btn btn-sm text-white px-3" style="background:#01a9ac;" onclick="importPreviewed()">
            <i class="fa fa-check-circle me-1"></i>Import these punches
        </button>
    </div>
    <div class="card-body p-0" style="max-height:480px;overflow-y:auto">
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0" id="previewTable">
            <thead class="table-light sticky-top">
                <tr>
                    <th class="ps-3" style="width:60px;">#</th>
                    <th style="width:110px;">Enroll ID</th>
                    <th>Matched Employee</th>
                    <th style="width:190px;">Punch Date &amp; Time</th>
                    <th class="pe-3" style="width:110px;">Device</th>
                </tr>
            </thead>
            <tbody id="previewBody"></tbody>
        </table></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/import.js" asp-append-version="true"></script>
}
