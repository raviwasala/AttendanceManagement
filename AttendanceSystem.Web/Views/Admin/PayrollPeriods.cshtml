@{
    ViewData["Title"] = "Payroll Months";
}

<div class="mb-3">
    <h5 class="mb-0">Payroll Months</h5>
    <div class="text-muted small">
        Which month payroll is working on. Every entry screen follows this.
    </div>
</div>

<div id="ppAlert"></div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header py-2"><strong class="small">Current</strong></div>
            <div class="card-body" id="ppCurrent">
                <div class="text-muted small">Loading…</div>
            </div>
        </div>

        @* Why the month is held rather than taken from the clock. Without this the screen
           looks like pointless ceremony, and somebody eventually "simplifies" it away. *@
        <div class="alert alert-light border py-2 small mt-3 mb-0">
            <strong>Why this exists.</strong> On the 3rd of August a clerk is usually still
            finishing July. If each screen defaulted to today's calendar month, that morning's
            entries would land in an August nobody has opened — and turn up on the wrong
            payslip a month later with nothing to flag it.
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-header py-2"><strong class="small">History</strong></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Month</th>
                                <th class="text-center">Status</th>
                                <th>Closed</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="ppBody">
                            <tr><td colspan="4" class="text-center py-4 text-muted">Loading…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ppOpenModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Open a Payroll Month</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label small">Month <span class="text-danger">*</span></label>
                <input type="month" id="ppOpenMonth" class="form-control">
                <div class="form-text small" id="ppOpenHint"></div>

                <label class="form-label small mt-3">Notes</label>
                <input type="text" id="ppOpenNotes" class="form-control" maxlength="250">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="ppOpen()">Open</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/payroll-periods.js" asp-append-version="true"></script>
}
