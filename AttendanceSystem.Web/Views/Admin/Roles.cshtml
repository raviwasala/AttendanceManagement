@{
    ViewData["Title"] = "Role & Access Control";
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col-auto">
            <h5 class="page-title mb-0">Role & Access Control</h5>
        </div>
        <div class="col-auto ms-auto">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Role & Access Control</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div id="alertContainer"></div>

<div class="row">
    <!-- ── Left Column: Roles Selection ── -->
    <div class="col-xl-3 col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:#01a9ac;">
                <h5 class="card-header-text text-white mb-0">
                    <i class="fa fa-users me-2"></i>System Roles
                </h5>
                <button class="btn btn-sm text-white" style="background:rgba(255,255,255,0.25);" onclick="openAddRoleModal()">
                    <i class="fa fa-plus me-1"></i>New Role
                </button>
            </div>
            <div class="card-block p-0">
                <div class="list-group list-group-flush" id="roleList">
                    <div class="text-center p-4 text-muted">
                        <i class="fa fa-spinner fa-spin fa-2x"></i>
                        <p class="mt-2 mb-0">Loading system roles...</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-block p-3">
                <h6 class="fw-bold mb-2" style="color:#01a9ac;">
                    <i class="fa fa-info-circle me-1"></i>Matrix Legend
                </h6>
                <p class="text-muted mb-1" style="font-size:.84rem;">
                    <span class="badge bg-primary me-1">Page View</span> Grants access to open the module page.
                </p>
                <p class="text-muted mb-0" style="font-size:.84rem;">
                    @* Named after the real actions. The legend used to say "Add" and "Print",
                       which are not actions this system has — the same mismatch that hid a
                       third of the matrix. *@
                    <span class="badge bg-success me-1">Actions</span> Controls Create, Save,
                    Delete, Export and — where a module has one — Authorise or Sync.
                </p>
            </div>
        </div>
    </div>

    <!-- ── Right Column: Page-by-Page & Transaction-Type Permission Matrix ── -->
    <div class="col-xl-9 col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="card-header-text mb-0" id="selectedRoleTitle">
                        <i class="fa fa-shield me-2" style="color:#01a9ac;"></i>Select a Role to Manage Permissions
                    </h5>
                    <small class="text-muted" id="selectedRoleDesc">Configure page access rights &amp; transaction privileges.</small>
                </div>
                <div id="roleActions" style="display:none;">
                    <button class="btn btn-sm btn-outline-secondary me-1" onclick="toggleAllPermissions(true)">
                        <i class="fa fa-check-square-o me-1"></i>Select All
                    </button>
                    <button class="btn btn-sm btn-outline-secondary me-2" onclick="toggleAllPermissions(false)">
                        <i class="fa fa-square-o me-1"></i>Deselect All
                    </button>
                    <button class="btn btn-sm text-white px-3" style="background:#01a9ac;" onclick="saveRolePermissions()">
                        <i class="fa fa-save me-1"></i>Save Access Rules
                    </button>
                </div>
            </div>

            <div class="card-block p-0">
                <div id="permissionMatrixContainer">
                    <div class="text-center p-5 text-muted">
                        <i class="fa fa-hand-o-left fa-3x mb-3" style="color:#01a9ac;"></i>
                        <h5>No Role Selected</h5>
                        <p class="mb-0">Please pick a system role from the left panel to configure its transaction matrix.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Add/Edit Role Modal ── -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white" style="background:#01a9ac;">
                <h5 class="modal-title" id="roleModalTitle">Add System Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    <input type="hidden" id="roleId" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="roleName" required placeholder="e.g. HR Manager / Supervisor" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea class="form-control" id="roleDescription" rows="3" placeholder="Description of permissions granted to this role..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn text-white" style="background:#01a9ac;" onclick="saveRole()">Save Role</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/roles.js" asp-append-version="true"></script>
}
