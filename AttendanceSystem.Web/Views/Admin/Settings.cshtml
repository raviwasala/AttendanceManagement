@{
    ViewData["Title"] = "Settings";
}

<h5 class="mb-3">Company Settings</h5>
<div id="settingsAlert"></div>

<!-- Company Logo Upload Card -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark"><i class="feather icon-image text-primary me-2"></i>Company Logo & Branding</h6>
    </div>
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4 text-center border-end py-2">
                <div class="p-3 bg-dark rounded d-inline-block shadow-sm">
                    <img id="currentLogoPreview" src="~/assets/images/samanmal_logo.png" alt="Company Logo"
                         style="max-height: 60px; max-width: 200px; object-fit: contain;"
                         onerror="this.src='/assets/images/logo.png'" />
                </div>
                <div class="text-muted small mt-2">Current System Logo Preview</div>
            </div>
            <div class="col-md-8 ps-md-4 mt-3 mt-md-0">
                <label class="form-label fw-semibold">Upload New Company Logo</label>
                <div class="input-group">
                    <input type="file" id="logoFileInput" class="form-control" accept="image/*" />
                    <button class="btn btn-primary px-4" onclick="uploadCompanyLogo()">
                        <i class="feather icon-upload me-1"></i> Upload Logo
                    </button>
                </div>
                <div class="form-text mt-2 text-muted">
                    Recommended: High-resolution PNG or WEBP with transparent or dark background. Supported formats: PNG, JPG, JPEG, WEBP, SVG.
                </div>
                <div id="logoUploadAlert" class="mt-2"></div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Company Name <span class="text-danger">*</span></label>
                <input type="text" id="companyName" class="form-control" maxlength="200">
            </div>
            <div class="col-md-6">
                <label class="form-label">Website</label>
                <input type="text" id="website" class="form-control" maxlength="200">
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input type="text" id="phone" class="form-control" maxlength="20">
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" id="email" class="form-control" maxlength="200">
            </div>
            <div class="col-12">
                <label class="form-label">Address</label>
                <textarea id="address" class="form-control" rows="2" maxlength="500"></textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label">Work Start Time</label>
                <input type="time" id="workStart" class="form-control">
            </div>
            <div class="col-md-4">
                <label class="form-label">Work End Time</label>
                <input type="time" id="workEnd" class="form-control">
            </div>
            <div class="col-md-4">
                <label class="form-label">Max Late Minutes</label>
                <input type="number" id="maxLate" class="form-control" min="0" max="120">
            </div>
            <div class="col-md-6">
                <label class="form-label">Weekend Days <small class="text-muted">(comma-separated, e.g. Saturday,Sunday)</small></label>
                <input type="text" id="weekendDays" class="form-control" placeholder="Saturday,Sunday">
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark">
            <i class="feather icon-sliders text-primary me-2"></i>System Configuration
        </h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Rows Per Page</label>
                <select id="pageSize" class="form-select">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="0">Show all (no paging)</option>
                </select>
                <div class="form-text">Applies to every list screen in the system.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Lock Screen After</label>
                <select id="screenLock" class="form-select">
                    <option value="0">Never</option>
                    <option value="1">1 minutes</option>
                    <option value="5">5 minutes</option>
                    <option value="10">10 minutes</option>
                    <option value="15">15 minutes</option>
                    <option value="30">30 minutes</option>
                    <option value="60">60 minutes</option>
                </select>
                @* Saying what it is *not* matters here: people read "lock" as "log out" and
                   worry about losing a half-finished form. *@
                <div class="form-text">
                    Idle time before the screen locks and asks for the password again. Your
                    work stays open — this is not a sign-out. The session itself still ends
                    after 60 minutes.
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label d-block">Safety</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="confirmDelete" checked>
                    <label class="form-check-label" for="confirmDelete">
                        Ask for confirmation before deleting a record
                    </label>
                </div>
                <div class="form-text">
                    Turn this off only if your operators are trusted — deletes take effect immediately.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 mb-4">
    <button class="btn btn-primary px-4" onclick="saveSettings()">
        <i class="feather icon-save me-1"></i>Save Settings
    </button>
</div>

@section Scripts {
    <script src="~/js/pages/admin/settings.js" asp-append-version="true"></script>
}

