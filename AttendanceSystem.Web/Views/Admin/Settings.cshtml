@{
    ViewData["Title"] = "Settings";
}

<h5 class="mb-3">Company Settings</h5>
<div id="settingsAlert"></div>

@* Tabbed rather than one long scroll: company details are edited occasionally, mail and SMS
   are touched once at setup and then only when something breaks. Keeping the gateways off the
   main page also stops an unrelated edit drawing attention to credentials.

   One Save button serves every tab — the settings are a single record, and per-tab saves
   would let somebody fill in the SMS tab, press Save on another, and lose it. *@
<ul class="nav nav-tabs mb-3" id="settingsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab">
            <i class="feather icon-home me-1"></i>General
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-system" type="button" role="tab">
            <i class="feather icon-sliders me-1"></i>System
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-email" type="button" role="tab">
            <i class="feather icon-mail me-1"></i>Email
            <span class="badge bg-secondary ms-1 d-none" id="emailStatusBadge">Off</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-sms" type="button" role="tab">
            <i class="feather icon-message-square me-1"></i>SMS
            <span class="badge bg-secondary ms-1 d-none" id="smsStatusBadge">Off</span>
        </button>
    </li>
</ul>

<div class="tab-content">
<div class="tab-pane fade show active" id="tab-general" role="tabpanel">

<!-- Company Logo Upload Card -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark"><i class="feather icon-image text-primary me-2"></i>Company Logo & Branding</h6>
    </div>
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4 text-center border-end py-2">
                <div class="p-3 bg-dark rounded d-inline-block shadow-sm">
                    <img id="currentLogoPreview" src="~/assets/images/samanmal_logo.png" alt="Company Logo"
                         style="max-height: 60px; max-width: 200px; object-fit: contain;"
                         onerror="this.src='/assets/images/logo.png'" />
                </div>
                <div class="text-muted small mt-2">Current System Logo Preview</div>
            </div>
            <div class="col-md-8 ps-md-4 mt-3 mt-md-0">
                <label class="form-label fw-semibold">Upload New Company Logo</label>
                <div class="input-group">
                    <input type="file" id="logoFileInput" class="form-control" accept="image/*" />
                    <button class="btn btn-primary px-4" onclick="uploadCompanyLogo()">
                        <i class="feather icon-upload me-1"></i> Upload Logo
                    </button>
                </div>
                <div class="form-text mt-2 text-muted">
                    Recommended: High-resolution PNG or WEBP with transparent or dark background. Supported formats: PNG, JPG, JPEG, WEBP, SVG.
                </div>
                <div id="logoUploadAlert" class="mt-2"></div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Company Name <span class="text-danger">*</span></label>
                <input type="text" id="companyName" class="form-control" maxlength="200">
            </div>
            <div class="col-md-6">
                <label class="form-label">Website</label>
                <input type="text" id="website" class="form-control" maxlength="200">
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input type="text" id="phone" class="form-control" maxlength="20">
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" id="email" class="form-control" maxlength="200">
            </div>
            <div class="col-12">
                <label class="form-label">Address</label>
                <textarea id="address" class="form-control" rows="2" maxlength="500"></textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label">Work Start Time</label>
                <input type="time" id="workStart" class="form-control">
            </div>
            <div class="col-md-4">
                <label class="form-label">Work End Time</label>
                <input type="time" id="workEnd" class="form-control">
            </div>
            <div class="col-md-4">
                <label class="form-label">Max Late Minutes</label>
                <input type="number" id="maxLate" class="form-control" min="0" max="120">
            </div>
            <div class="col-md-6">
                <label class="form-label">Weekend Days <small class="text-muted">(comma-separated, e.g. Saturday,Sunday)</small></label>
                <input type="text" id="weekendDays" class="form-control" placeholder="Saturday,Sunday">
            </div>
        </div>
    </div>
</div>

</div><!-- /tab-general -->

<div class="tab-pane fade" id="tab-system" role="tabpanel">

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark">
            <i class="feather icon-sliders text-primary me-2"></i>System Configuration
        </h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Rows Per Page</label>
                <select id="pageSize" class="form-select">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="0">Show all (no paging)</option>
                </select>
                <div class="form-text">Applies to every list screen in the system.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Lock Screen After</label>
                <select id="screenLock" class="form-select">
                    <option value="0">Never</option>
                    <option value="1">1 minutes</option>
                    <option value="5">5 minutes</option>
                    <option value="10">10 minutes</option>
                    <option value="15">15 minutes</option>
                    <option value="30">30 minutes</option>
                    <option value="60">60 minutes</option>
                </select>
                @* Saying what it is *not* matters here: people read "lock" as "log out" and
                   worry about losing a half-finished form. *@
                <div class="form-text">
                    Idle time before the screen locks and asks for the password again. Your
                    work stays open — this is not a sign-out. The session itself still ends
                    after 60 minutes.
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label d-block">Safety</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="confirmDelete" checked>
                    <label class="form-check-label" for="confirmDelete">
                        Ask for confirmation before deleting a record
                    </label>
                </div>
                <div class="form-text">
                    Turn this off only if your operators are trusted — deletes take effect immediately.
                </div>
            </div>
        </div>
    </div>
</div>

</div><!-- /tab-system -->

<div class="tab-pane fade" id="tab-email" role="tabpanel">

@* Password reset is the only thing that mails, and it deliberately says "check your email"
   whether or not the account exists — so an unconfigured mail server fails invisibly. The
   test button is the only way to find out before a locked-out user does. *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark">
            <i class="feather icon-mail text-primary me-2"></i>Email (SMTP)
        </h6>
    </div>
    <div class="card-body">
        <div class="alert alert-light border py-2 small">
            <i class="feather icon-info me-1"></i>
            Used to send <strong>password reset</strong> messages. Without a working mail
            server, staff who forget their password cannot recover it themselves — and the
            reset screen still says "check your email", so nothing reports the failure.
            Send a test message after saving.
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label d-block">Status</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="smtpEnabled">
                    <label class="form-check-label" for="smtpEnabled">Send email</label>
                </div>
                <div class="form-text">Off means no mail is attempted.</div>
            </div>
            <div class="col-md-5">
                <label class="form-label">SMTP Host</label>
                <input type="text" id="smtpHost" class="form-control" placeholder="smtp.gmail.com" maxlength="200">
            </div>
            <div class="col-md-3">
                <label class="form-label">Port</label>
                <input type="number" id="smtpPort" class="form-control" value="587" min="1" max="65535">
                <div class="form-text">587 with SSL/TLS, 25 without.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Username</label>
                <input type="text" id="smtpUsername" class="form-control" autocomplete="off" maxlength="200">
            </div>
            <div class="col-md-4">
                <label class="form-label">Password</label>
                @* Never populated from the server. It is stored encrypted and cannot be read
                   back, so blank means "keep the existing one". *@
                <input type="password" id="smtpPassword" class="form-control" autocomplete="new-password"
                       placeholder="Leave blank to keep current">
                <div class="form-text" id="smtpPasswordState">No password saved.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label d-block">Encryption</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="smtpSsl" checked>
                    <label class="form-check-label" for="smtpSsl">Use SSL/TLS</label>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">From Address</label>
                <input type="email" id="smtpFrom" class="form-control" placeholder="noreply@yourcompany.com" maxlength="200">
                <div class="form-text">Defaults to the username when blank.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">From Name</label>
                <input type="text" id="smtpFromName" class="form-control" placeholder="Attendance System" maxlength="200">
            </div>
        </div>

        <hr class="my-3">

        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Send a test message to</label>
                <input type="email" id="testEmailTo" class="form-control" placeholder="you@yourcompany.com">
            </div>
            <div class="col-md-6">
                <button class="btn btn-outline-primary" onclick="sendTestEmail()" id="testEmailBtn">
                    <i class="feather icon-navigation me-1"></i>Save &amp; Send Test
                </button>
                <div class="form-text">Settings are saved first, so the test proves what you just typed.</div>
            </div>
        </div>
    </div>
</div>

</div><!-- /tab-email -->

<div class="tab-pane fade" id="tab-sms" role="tabpanel">

@* Deliberately a generic HTTP gateway rather than one vendor's fields. Text.lk, Notify.lk,
   Dialog and Mobitel are all plain HTTP that disagree only about parameter names, so a
   template keeps switching provider a settings change instead of a code change. *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark">
            <i class="feather icon-message-square text-primary me-2"></i>SMS Gateway
        </h6>
    </div>
    <div class="card-body">
        <div class="alert alert-warning py-2 small">
            <i class="feather icon-alert-triangle me-1"></i>
            <strong>Nothing sends SMS automatically yet.</strong> You can configure and test the
            gateway here, but no event in the system triggers a message. Tell me which events
            should notify by SMS — leave decisions are the usual choice — and I will wire them up.
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label d-block">Status</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="smsEnabled">
                    <label class="form-check-label" for="smsEnabled">Send SMS</label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Provider</label>
                <input type="text" id="smsProvider" class="form-control" placeholder="Text.lk" maxlength="100">
                <div class="form-text">A label for your reference only.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Sender ID</label>
                <input type="text" id="smsSenderId" class="form-control" placeholder="MyCompany" maxlength="50">
                <div class="form-text">Registered sender name or short code.</div>
            </div>

            <div class="col-md-8">
                <label class="form-label">API URL</label>
                <input type="text" id="smsApiUrl" class="form-control" placeholder="https://app.text.lk/api/v3/sms/send">
            </div>
            <div class="col-md-2">
                <label class="form-label">Method</label>
                <select id="smsMethod" class="form-select">
                    <option value="POST">POST</option>
                    <option value="GET">GET</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Format</label>
                <select id="smsContentType" class="form-select">
                    <option value="application/json">JSON</option>
                    <option value="application/x-www-form-urlencoded">Form</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">API Key / Token</label>
                <input type="password" id="smsApiKey" class="form-control" autocomplete="new-password"
                       placeholder="Leave blank to keep current">
                <div class="form-text" id="smsApiKeyState">No API key saved.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Authorization Header <small class="text-muted">(optional)</small></label>
                <input type="text" id="smsAuthHeader" class="form-control" placeholder="Bearer {apikey}">
                <div class="form-text">Leave blank if the key goes in the request instead.</div>
            </div>

            <div class="col-12">
                <label class="form-label">Request Template</label>
                <textarea id="smsTemplate" class="form-control font-monospace" rows="4"
                          placeholder='{"recipient":"{to}","sender_id":"{sender}","message":"{message}"}'></textarea>
                <div class="form-text">
                    Request body for POST, or query string for GET. Placeholders:
                    <code>{to}</code>, <code>{message}</code>, <code>{apikey}</code>, <code>{sender}</code>.
                    Values are escaped for you, so a message containing quotes or
                    <code>&amp;</code> will not break the request.
                </div>
            </div>
        </div>

        <hr class="my-3">

        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Send a test SMS to</label>
                <input type="text" id="testSmsTo" class="form-control" placeholder="+94771234567">
                <div class="form-text">Use the format your gateway expects.</div>
            </div>
            <div class="col-md-6">
                <button class="btn btn-outline-primary" onclick="sendTestSms()" id="testSmsBtn">
                    <i class="feather icon-navigation me-1"></i>Save &amp; Send Test
                </button>
                <div class="form-text">A real message is sent and will be charged by your provider.</div>
            </div>
        </div>
    </div>
</div>

</div><!-- /tab-sms -->
</div><!-- /tab-content -->

<div class="mt-3 mb-4">
    <button class="btn btn-primary px-4" onclick="saveSettings()">
        <i class="feather icon-save me-1"></i>Save Settings
    </button>
    <span class="text-muted small ms-2">Saves every tab.</span>
</div>

@section Scripts {
    <script src="~/js/pages/admin/settings.js" asp-append-version="true"></script>
}

