@{
    ViewData["Title"] = "Employee Profile";
    var canEdit = ViewContext.HasPermission(AppConstants.Modules.Employees, AppConstants.Actions.Edit);
    var canDelete = ViewContext.HasPermission(AppConstants.Modules.Employees, AppConstants.Actions.Delete);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-1" id="pfName">Employee Profile</h5>
        <p class="text-muted small mb-0" id="pfSubtitle">&nbsp;</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/Employees" class="btn btn-light btn-sm px-3">
            <i class="feather icon-arrow-left me-1"></i>Back to list
        </a>
        @if (canEdit)
        {
            <button class="btn btn-outline-secondary btn-sm px-3" onclick="openTransfer()">
                <i class="feather icon-shuffle me-1"></i>Transfer
            </button>
            <button class="btn btn-outline-secondary btn-sm px-3" onclick="openStatus()">
                <i class="feather icon-toggle-left me-1"></i>Status
            </button>
            <button class="btn btn-outline-danger btn-sm px-3" id="pfResignBtn" onclick="openResign()">
                <i class="feather icon-log-out me-1"></i>Resign
            </button>
            <button class="btn btn-outline-success btn-sm px-3 d-none" id="pfRejoinBtn" onclick="openRejoin()">
                <i class="feather icon-rotate-ccw me-1"></i>Rejoin
            </button>
        }
    </div>
</div>

<div id="pfError" class="alert alert-danger d-none" role="alert"></div>

<div class="row g-3">
    @* ── Left: identity ──────────────────────────────────────────────────── *@
    <div class="col-xl-4">
        <div class="card">
            <div class="card-body text-center">
                <img id="pfPhoto" class="rounded-circle border bg-light mb-2"
                     style="width:110px;height:110px;object-fit:cover;" alt="Employee photo">
                <h6 class="mb-0" id="pfFullName">—</h6>
                <div class="text-muted small" id="pfDesignation">—</div>
                <div class="mt-2" id="pfStatusBadge"></div>
            </div>
            <ul class="list-group list-group-flush small" id="pfDetails"></ul>
        </div>

        <div class="card mt-3">
            <div class="card-header py-2"><strong class="small">Leave balances</strong></div>
            <div class="card-body py-2" id="pfBalances">
                <div class="text-muted small">Loading…</div>
            </div>
        </div>
    </div>

    @* ── Right: tabs ─────────────────────────────────────────────────────── *@
    <div class="col-xl-8">
        <div class="row g-2 mb-3" id="pfStats"></div>

        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#pf-history" role="tab">
                <i class="feather icon-clock me-1"></i>History</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#pf-documents" role="tab">
                <i class="feather icon-file-text me-1"></i>Documents</a></li>
            @* Only rendered for users who may see pay. The API enforces it too — this just
               avoids showing a tab that would answer with 403. *@
            @if (ViewContext.HasPermission(AttendanceSystem.Common.Constants.AppConstants.Modules.Payroll,
                                           AttendanceSystem.Common.Constants.AppConstants.Actions.View))
            {
                <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#pf-payroll" role="tab">
                    <i class="feather icon-credit-card me-1"></i>Payroll</a></li>
            }
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="pf-history" role="tabpanel">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="width:110px;">Effective</th>
                                        <th style="width:110px;">Change</th>
                                        <th>From → To</th>
                                        <th class="pe-3">Reason</th>
                                    </tr>
                                </thead>
                                <tbody id="pfHistoryBody">
                                    <tr><td colspan="4" class="text-center py-4 text-muted">Loading…</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="pf-documents" role="tabpanel">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                        <strong class="small">Documents</strong>
                        @if (canEdit)
                        {
                            <button class="btn btn-sm btn-primary px-3" onclick="openUpload()">
                                <i class="feather icon-upload me-1"></i>Upload
                            </button>
                        }
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Title</th>
                                        <th style="width:110px;">Type</th>
                                        <th style="width:90px;">Size</th>
                                        <th style="width:110px;">Expires</th>
                                        <th class="pe-3 text-center" style="width:90px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="pfDocBody">
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Loading…</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            @if (ViewContext.HasPermission(AttendanceSystem.Common.Constants.AppConstants.Modules.Payroll,
                                           AttendanceSystem.Common.Constants.AppConstants.Actions.View))
            {
            <div class="tab-pane fade" id="pf-payroll" role="tabpanel">
                <div id="pfPayrollWarnings"></div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                        <strong class="small">Payroll Details</strong>
                        <button class="btn btn-sm btn-primary" onclick="pfSavePayroll()">
                            <i class="feather icon-save me-1"></i>Save
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Salary Grade</label>
                                <select id="pfGrade" class="form-select form-select-sm"></select>
                                <div class="form-text small" id="pfBasicHint">Basic salary comes from the grade.</div>
                            </div>
                            @* Blank means "follow the grade", so a grade revision still moves
                               this person. A figure here detaches them from it. *@
                            <div class="col-md-4">
                                <label class="form-label small">Own Salary <span class="text-muted">(optional)</span></label>
                                <input type="number" step="0.01" id="pfOwnSalary"
                                       class="form-control form-control-sm" placeholder="Follows the grade">
                                <div class="form-text small" id="pfSalaryHint"></div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Salary Group</label>
                                <select id="pfGroup" class="form-select form-select-sm"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Sub-department</label>
                                <select id="pfSubDept" class="form-select form-select-sm"></select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small">Employment Category</label>
                                <select id="pfCategory" class="form-select form-select-sm"></select>
                                <div class="form-text small" id="pfCategoryHint">
                                    Sets whether EPF/ETF apply by default.
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">OT Limit (hours / month)</label>
                                <input type="number" step="0.5" id="pfOtLimit" class="form-control form-control-sm">
                                <div class="form-text small">0 means no cap.</div>
                            </div>

                            @* ── EPF / ETF ──────────────────────────────────────── *@
                            <div class="col-12"><hr class="my-2">
                                <div class="small fw-semibold text-muted">EPF &amp; ETF</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small d-block">Membership</label>
                                <div class="form-check form-check-inline form-switch">
                                    <input class="form-check-input" type="checkbox" id="pfEpfMember">
                                    <label class="form-check-label small" for="pfEpfMember">EPF member</label>
                                </div>
                                <div class="form-check form-check-inline form-switch">
                                    <input class="form-check-input" type="checkbox" id="pfEtfMember">
                                    <label class="form-check-label small" for="pfEtfMember">ETF member</label>
                                </div>
                                <div class="form-text small">
                                    Switch off for staff outside the scheme — the calculation skips them entirely.
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">EPF Number</label>
                                <input type="text" id="pfEpfNo" class="form-control form-control-sm" maxlength="30">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">ETF Number</label>
                                <input type="text" id="pfEtfNo" class="form-control form-control-sm" maxlength="30">
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small">EPF Registration</label>
                                <select id="pfEpfRegBranch" class="form-select form-select-sm"></select>
                                <div class="form-text small">Which branch's registration this person is filed under.</div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">EPF Status</label>
                                <input type="text" id="pfEpfStatus" class="form-control form-control-sm" maxlength="10" placeholder="E">
                            </div>

                            @* Blank keeps the company rate, so who is on the standard rate
                               stays visible rather than every employee carrying a copy. *@
                            <div class="col-md-7">
                                <label class="form-label small d-block">
                                    Rate overrides
                                    <span class="text-muted">— leave blank to use the company rates</span>
                                </label>
                                <div class="row g-1">
                                    <div class="col-4">
                                        <input type="number" step="0.01" id="pfEpfEmpPct"
                                               class="form-control form-control-sm" placeholder="EPF employee %">
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.01" id="pfEpfErPct"
                                               class="form-control form-control-sm" placeholder="EPF employer %">
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.01" id="pfEtfPct"
                                               class="form-control form-control-sm" placeholder="ETF employer %">
                                    </div>
                                </div>
                                <div class="form-text small" id="pfRateHint"></div>
                            </div>

                            @* ── Tax ────────────────────────────────────────────── *@
                            <div class="col-12"><hr class="my-2">
                                <div class="small fw-semibold text-muted">APIT (PAYE)</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small d-block">&nbsp;</label>
                                <div class="form-check form-switch mt-1">
                                    <input class="form-check-input" type="checkbox" id="pfApit">
                                    <label class="form-check-label small" for="pfApit">APIT deducted</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Tax Table</label>
                                <select id="pfTaxTable" class="form-select form-select-sm"></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Additional Tax</label>
                                <input type="number" step="0.01" id="pfAddTax" class="form-control form-control-sm">
                                <div class="form-text small">Added to the computed tax.</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small d-block">&nbsp;</label>
                                <div class="form-check form-switch mt-1">
                                    <input class="form-check-input" type="checkbox" id="pfTaxOnTax">
                                    <label class="form-check-label small" for="pfTaxOnTax">Tax on tax</label>
                                </div>
                                <div class="form-text small">Employer bears the tax; pay is grossed up.</div>
                            </div>

                            <div class="col-12"><hr class="my-2">
                                <div class="small fw-semibold text-muted">Bank</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small">Bank Branch</label>
                                <select id="pfBankBranch" class="form-select form-select-sm"></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Account Number</label>
                                <input type="text" id="pfAccountNo" class="form-control form-control-sm" maxlength="30">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Account Name</label>
                                <input type="text" id="pfAccountName" class="form-control form-control-sm" maxlength="150">
                                <div class="form-text small">Only if it differs from the employee's name.</div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small d-block">&nbsp;</label>
                                <div class="form-check form-switch mt-1">
                                    <input class="form-check-input" type="checkbox" id="pfBankTransfer">
                                    <label class="form-check-label small" for="pfBankTransfer">Bank transfer</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Shows the default alongside the employee's value, so an override is
                   visible as a deliberate difference rather than just a number. *@
                <div class="card">
                    <div class="card-header py-2">
                        <strong class="small">Allowances &amp; Deductions</strong>
                        <span class="text-muted small ms-1">
                            Blank uses the default. Enter a value to override it for this employee.
                        </span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Component</th>
                                        <th>Type</th>
                                        <th class="text-end">Default</th>
                                        <th class="text-end" style="width:150px;">This Employee</th>
                                        <th class="text-end pe-3">Effective</th>
                                    </tr>
                                </thead>
                                <tbody id="pfComponentBody">
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Loading…</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</div>

@* ── Transfer ────────────────────────────────────────────────────────────── *@
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Transfer Employee</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                @* Leaving a field unchanged is how you transfer only one thing. Saying so
                   avoids somebody re-picking the current department to "keep" it, which the
                   service would then reject as nothing to transfer. *@
                <div class="small text-muted mb-3">
                    Change only what is moving. Anything left as it is stays unchanged.
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Department</label>
                    <select id="trDept" class="form-select form-select-sm"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Designation</label>
                    <select id="trDesig" class="form-select form-select-sm"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Branch</label>
                    <select id="trBranch" class="form-select form-select-sm"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Effective date <span class="text-danger">*</span></label>
                    <input type="date" id="trDate" class="form-control form-control-sm">
                    <div class="small text-muted mt-1">
                        The date the move takes effect, which may be earlier than today.
                    </div>
                </div>
                <div class="mb-0">
                    <label class="form-label small fw-semibold">Reason</label>
                    <textarea id="trReason" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary btn-sm px-4" onclick="submitTransfer()">Transfer</button>
            </div>
        </div>
    </div>
</div>

@* ── Status ──────────────────────────────────────────────────────────────── *@
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Change Status</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Status <span class="text-danger">*</span></label>
                    @* Resigned and Terminated are absent on purpose: both need a last working
                       day, so they go through Resign. *@
                    <select id="stStatus" class="form-select form-select-sm">
                        <option value="1">Active</option>
                        <option value="4">Suspended</option>
                        <option value="5">On long leave</option>
                    </select>
                    <div class="small text-muted mt-1">
                        To record a resignation or termination, use <strong>Resign</strong> — it
                        needs a last working day.
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Effective date <span class="text-danger">*</span></label>
                    <input type="date" id="stDate" class="form-control form-control-sm">
                </div>
                <div class="mb-0">
                    <label class="form-label small fw-semibold">Reason <span class="text-danger">*</span></label>
                    <textarea id="stReason" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary btn-sm px-4" onclick="submitStatus()">Save</button>
            </div>
        </div>
    </div>
</div>

@* ── Resign ──────────────────────────────────────────────────────────────── *@
<div class="modal fade" id="resignModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Record Resignation</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="alert alert-warning py-2 small">
                    <i class="feather icon-alert-triangle me-1"></i>
                    Biometric punches dated after the last working day will be skipped on import
                    and reported, rather than counted as this employee's attendance.
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Last working day <span class="text-danger">*</span></label>
                    <input type="date" id="rsDate" class="form-control form-control-sm">
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="rsTermination">
                    <label class="form-check-label small" for="rsTermination">
                        This is a termination, not a resignation
                    </label>
                </div>
                <div class="mb-0">
                    <label class="form-label small fw-semibold">Reason <span class="text-danger">*</span></label>
                    <textarea id="rsReason" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm px-4" onclick="submitResign()">Record</button>
            </div>
        </div>
    </div>
</div>

@* ── Upload document ─────────────────────────────────────────────────────── *@
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Upload Document</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small fw-semibold">File <span class="text-danger">*</span></label>
                    <input type="file" id="dcFile" class="form-control form-control-sm">
                    <div class="small text-muted mt-1">
                        Up to 10 MB. Programs and web pages are not accepted.
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-7">
                        <label class="form-label small fw-semibold">Title</label>
                        <input type="text" id="dcTitle" class="form-control form-control-sm"
                               maxlength="200" placeholder="Defaults to the file name">
                    </div>
                    <div class="col-5">
                        <label class="form-label small fw-semibold">Type</label>
                        <select id="dcType" class="form-select form-select-sm">
                            <option value="1">NIC</option>
                            <option value="2">Passport</option>
                            <option value="3">Certificate</option>
                            <option value="4">Contract</option>
                            <option value="5">Resume</option>
                            <option value="6">Medical</option>
                            <option value="99" selected>Other</option>
                        </select>
                    </div>
                </div>
                <div class="mb-0">
                    <label class="form-label small fw-semibold">Expires on</label>
                    <input type="date" id="dcExpiry" class="form-control form-control-sm">
                    <div class="small text-muted mt-1">
                        For documents that lapse — a work permit, a medical certificate. Leave
                        blank otherwise.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary btn-sm px-4" onclick="submitUpload()">Upload</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.profileId = @ViewBag.EmployeeId;
        window.profilePerms = {
            edit: @(canEdit ? "true" : "false"),
            del:  @(canDelete ? "true" : "false")
        };
    </script>
    <script src="~/js/pages/admin/employee-profile.js" asp-append-version="true"></script>
    @* Only sent to users who can see the tab it drives. *@
    @if (ViewContext.HasPermission(AttendanceSystem.Common.Constants.AppConstants.Modules.Payroll,
                                   AttendanceSystem.Common.Constants.AppConstants.Actions.View))
    {
        <script src="~/js/pages/admin/employee-payroll.js" asp-append-version="true"></script>
    }
}
