@using System.Reflection
@using AttendanceSystem.Common.Constants
@{
    ViewData["Title"] = "Audit Log";

    // Listed from the module constants rather than from whatever happens to be in the last
    // page of results — otherwise a module with no recent activity is missing from the filter,
    // which is exactly when you want to select it and see "nothing logged".
    var auditModules = typeof(AppConstants.Modules)
        .GetFields(BindingFlags.Public | BindingFlags.Static | BindingFlags.FlattenHierarchy)
        .Where(f => f.IsLiteral && f.FieldType == typeof(string))
        .Select(f => (string)f.GetRawConstantValue()!)
        .OrderBy(m => m)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-1">Audit Log</h5>
        <p class="text-muted small mb-0">Who changed what, and when</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <select id="alModule" class="form-select form-select-sm" style="width:auto;">
            <option value="">All Modules</option>
            @foreach (var m in auditModules)
            {
                <option value="@m">@m</option>
            }
        </select>
        @* Search runs in SQL now, so it is debounced in the page script rather than firing a
           re-render on every keystroke. The old "Last 100/200/500" selector is gone: paging is
           server-side, and rows per page comes from Settings -> System Configuration. *@
        <input type="search" id="alSearch" class="form-control form-control-sm" style="width:220px;"
               placeholder="Search user / action / record…" autocomplete="off">
        <button class="btn btn-primary btn-sm px-3" onclick="loadAudit(1)">
            <i class="feather icon-refresh-cw me-1"></i>Refresh
        </button>
    </div>
</div>

@* The log is append-only: there is no edit or delete, deliberately. Saying so prevents
   someone hunting for the button. *@
<div class="alert alert-light border py-2 small" role="status">
    <i class="feather icon-lock me-1"></i>
    This log is read-only. Entries are written automatically and cannot be edited or removed.
</div>

<div class="card card-table-container">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">When</th>
                        <th>User</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Record</th>
                        <th class="pe-3">Changes</th>
                    </tr>
                </thead>
                <tbody id="auditBody">
                    <tr><td colspan="6" class="text-center py-4 text-muted">Loading…</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="small text-muted mt-2" id="auditCount"></div>

@section Scripts {
    <script src="~/js/pages/admin/audit-logs.js" asp-append-version="true"></script>
}
