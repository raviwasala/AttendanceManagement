@{
    ViewData["Title"] = "Reports";
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabMonthly">Monthly Summary</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabDaily">Daily Report</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabLate">Late Report</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabLeave">Leave Report</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabEmps">Employee List</a></li>
</ul>

<div class="tab-content">

    <!-- Monthly Summary -->
    <div class="tab-pane fade show active" id="tabMonthly">
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2"><label class="form-label small mb-1">Month</label>
                        <select id="mMonth" class="form-select form-select-sm">
                            @for(int m=1;m<=12;m++){<option value="@m" selected="@(m==DateTime.Now.Month)">@(new DateTime(2000,m,1).ToString("MMMM"))</option>}
                        </select>
                    </div>
                    <div class="col-md-2"><label class="form-label small mb-1">Year</label><input type="number" id="mYear" class="form-control form-control-sm" value="@DateTime.Now.Year"></div>
                    <div class="col-md-3"><label class="form-label small mb-1">Department</label><select id="mDept" class="form-select form-select-sm"><option value="">All Departments</option></select></div>
                    <div class="col-md-2"><button class="btn btn-primary btn-sm" onclick="loadMonthly()">Generate</button></div>
                </div>
            </div>
        </div>
        <div class="card"><div class="card-body p-0">
            <div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light">
                <tr><th>Code</th><th>Employee</th><th>Dept</th><th>Present</th><th>Absent</th><th>Late</th><th>Leave</th><th>Holiday</th><th>Hrs</th><th>Att%</th></tr>
            </thead><tbody id="mBody"><tr><td colspan="10" class="text-center py-3 text-muted">Click Generate to load report.</td></tr></tbody></table></div>
        </div></div>
    </div>

    <!-- Daily Report -->
    <div class="tab-pane fade" id="tabDaily">
        <div class="card mb-2"><div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3"><label class="form-label small mb-1">Date</label><input type="date" id="dDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")"></div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm" onclick="loadDaily()">Generate</button></div>
            </div>
        </div></div>
        <div class="card"><div class="card-body p-0">
            <div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light">
                <tr><th>Code</th><th>Employee</th><th>Dept</th><th>Check In</th><th>Check Out</th><th>Hrs</th><th>Status</th><th>Late</th></tr>
            </thead><tbody id="dBody"><tr><td colspan="8" class="text-center py-3 text-muted">Select a date and click Generate.</td></tr></tbody></table></div>
        </div></div>
    </div>

    <!-- Late Report -->
    <div class="tab-pane fade" id="tabLate">
        <div class="card mb-2"><div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-2"><label class="form-label small mb-1">From</label><input type="date" id="lFrom" class="form-control form-control-sm"></div>
                <div class="col-md-2"><label class="form-label small mb-1">To</label><input type="date" id="lTo" class="form-control form-control-sm"></div>
                <div class="col-md-3"><label class="form-label small mb-1">Department</label><select id="lDept" class="form-select form-select-sm"><option value="">All</option></select></div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm" onclick="loadLate()">Generate</button></div>
            </div>
        </div></div>
        <div class="card"><div class="card-body p-0">
            <div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light">
                <tr><th>Date</th><th>Code</th><th>Employee</th><th>Dept</th><th>Check In</th><th>Late Min</th></tr>
            </thead><tbody id="lBody"><tr><td colspan="6" class="text-center py-3 text-muted">Set range and click Generate.</td></tr></tbody></table></div>
        </div></div>
    </div>

    <!-- Leave Report -->
    <div class="tab-pane fade" id="tabLeave">
        <div class="card mb-2"><div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-2"><label class="form-label small mb-1">From</label><input type="date" id="lvFrom" class="form-control form-control-sm"></div>
                <div class="col-md-2"><label class="form-label small mb-1">To</label><input type="date" id="lvTo" class="form-control form-control-sm"></div>
                <div class="col-md-3"><label class="form-label small mb-1">Department</label><select id="lvDept" class="form-select form-select-sm"><option value="">All</option></select></div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm" onclick="loadLeaveRpt()">Generate</button></div>
            </div>
        </div></div>
        <div class="card"><div class="card-body p-0">
            <div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light">
                <tr><th>Employee</th><th>Dept</th><th>Leave Type</th><th>From</th><th>To</th><th>Days</th><th>Status</th></tr>
            </thead><tbody id="lvBody"><tr><td colspan="7" class="text-center py-3 text-muted">Set range and click Generate.</td></tr></tbody></table></div>
        </div></div>
    </div>

    <!-- Employee List -->
    <div class="tab-pane fade" id="tabEmps">
        <div class="card mb-2"><div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3"><label class="form-label small mb-1">Department</label><select id="eDept" class="form-select form-select-sm"><option value="">All</option></select></div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm" onclick="loadEmpList()">Generate</button></div>
            </div>
        </div></div>
        <div class="card"><div class="card-body p-0">
            <div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light">
                <tr><th>Code</th><th>Name</th><th>Department</th><th>Designation</th><th>Branch</th><th>Phone</th><th>Email</th><th>Status</th></tr>
            </thead><tbody id="eBody"><tr><td colspan="8" class="text-center py-3 text-muted">Click Generate to load.</td></tr></tbody></table></div>
        </div></div>
    </div>

</div>

@section Scripts {
    <script src="~/js/pages/admin/reports.js" asp-append-version="true"></script>
}

