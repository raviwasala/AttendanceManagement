@{
    ViewData["Title"] = "Staff Loans";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0">Staff Loans</h5>
        <div class="text-muted small">Granting, recovery and early settlement.</div>
    </div>
    <button class="btn btn-primary btn-sm" onclick="lnLoanModal()">+ Grant a Loan</button>
</div>

<div id="lnAlert"></div>

<div class="row g-2 mb-3" id="lnSummary"></div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Search</label>
                <input type="text" id="lnSearch" class="form-control form-control-sm"
                       placeholder="Employee name or code…" oninput="lnFilter()">
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Status</label>
                <select id="lnStatus" class="form-select form-select-sm" onchange="lnFilter()">
                    <option value="1">Active</option>
                    <option value="">All</option>
                    <option value="2">Settled</option>
                    <option value="3">Cancelled</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Employee</th>
                        <th>Loan</th>
                        <th>Date</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Interest</th>
                        <th class="text-end">Instalment</th>
                        <th class="text-end">Recovered</th>
                        <th class="text-end">Balance</th>
                        <th class="text-center">Guarantors</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody id="lnBody">
                    <tr><td colspan="11" class="text-center py-4 text-muted">Loading…</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@* One modal with two tabs, mirroring the old Loan Details screen. Guarantors are part of
   granting a loan, not a separate act, so they belong in the same dialog. *@
<div class="modal fade" id="lnModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="lnModalTitle">Grant a Loan</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#ln-details">
                        Loan Details</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#ln-guarantors">
                        Guarantors</a></li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="ln-details" role="tabpanel">
                        <div class="row g-2">
                            <div class="col-md-12">
                                <label class="form-label small">Employee <span class="text-danger">*</span></label>
                                <select id="lnEmployee" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Loan Type <span class="text-danger">*</span></label>
                                <select id="lnType" class="form-select" onchange="lnTypeChanged()"></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Date</label>
                                <input type="date" id="lnDate" class="form-control">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Interest %</label>
                                <input type="number" step="0.01" id="lnRate" class="form-control"
                                       oninput="lnPreview()">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small">Loan Amount <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" id="lnAmount" class="form-control"
                                       oninput="lnPreview()">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">No. of Instalments <span class="text-danger">*</span></label>
                                <input type="number" id="lnMonths" class="form-control" oninput="lnPreview()">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small d-block">&nbsp;</label>
                                <div class="form-check form-switch mt-1">
                                    <input class="form-check-input" type="checkbox" id="lnThisMonth" checked>
                                    <label class="form-check-label small" for="lnThisMonth">Reduce this month</label>
                                </div>
                                <div class="form-text small">Off starts recovery next month.</div>
                            </div>

                            @* Computed live rather than typed. The instalment follows from the
                               amount, rate and term, and letting somebody type it would allow
                               a schedule that never clears the loan. *@
                            <div class="col-12">
                                <div class="alert alert-light border py-2 mb-0" id="lnPreviewBox">
                                    Enter an amount and a number of instalments to see the schedule.
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label small">Notes</label>
                                <input type="text" id="lnNotes" class="form-control" maxlength="500">
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="ln-guarantors" role="tabpanel">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small">Guarantor 1</label>
                                <select id="lnG1" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Guarantor 2</label>
                                <select id="lnG2" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Guarantor 3</label>
                                <select id="lnG3" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Guarantor 4</label>
                                <select id="lnG4" class="form-select"></select>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="lnAllowGrant">
                                    <label class="form-check-label small" for="lnAllowGrant">
                                        Allow to grant loans
                                    </label>
                                </div>
                                <div class="form-text small">
                                    Carried across from the old system. Confirm what it should do before
                                    anything relies on it — nothing reads it yet.
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="alert alert-light border py-2 small mb-0">
                                    An employee cannot guarantee their own loan. Where a guarantor already
                                    stands behind other active loans, the list shows how many.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="lnSave()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Settlement ── -->
<div class="modal fade" id="lnSettleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Loan Settlement</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @* The current position is shown first, so nobody types a settlement figure
                   without seeing what is actually outstanding. *@
                <div class="card mb-3">
                    <div class="card-header py-2"><strong class="small">Current Status</strong></div>
                    <div class="card-body py-2" id="lnSettleStatus"></div>
                </div>

                <input type="hidden" id="lnSettleId">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small">Date</label>
                        <input type="date" id="lnSettleDate" class="form-control">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Amount Paying <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" id="lnSettleAmount" class="form-control"
                               oninput="lnSettlePreview()">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Remaining Instalments</label>
                        <input type="number" id="lnSettleMonths" class="form-control"
                               placeholder="keep current" oninput="lnSettlePreview()">
                        <div class="form-text small">Blank keeps the present instalment.</div>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-light border py-2 mb-0 small" id="lnSettlePreviewBox"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Notes</label>
                        <input type="text" id="lnSettleNotes" class="form-control" maxlength="500">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="lnSettle()">Record Settlement</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Transaction history ── -->
<div class="modal fade" id="lnHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Loan History</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th class="ps-3">Date</th><th>Period</th><th>Type</th>
                            <th class="text-end">Amount</th><th class="pe-3">Notes</th></tr>
                    </thead>
                    <tbody id="lnHistoryBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/loans.js" asp-append-version="true"></script>
}
