@{
    ViewData["Title"] = "Transaction Schedule";
}

<div class="mb-3">
    <h5 class="mb-0">Transaction Schedule</h5>
    <div class="text-muted small">
        Allowances and deductions for one employee, each running between two months.
    </div>
</div>

<div id="tsAlert"></div>

<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small">Employee <span class="text-danger">*</span></label>
                <select id="tsEmployee" class="form-select" data-search onchange="tsLoad()"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">&nbsp;</label>
                <button class="btn btn-primary w-100" id="tsAddBtn" onclick="tsRowModal()" disabled>
                    + Add Entry
                </button>
            </div>
        </div>
    </div>
</div>

@* A dated schedule rather than a plain value, which is the point of this screen: an
   allowance with an end month stops on its own, instead of relying on somebody remembering
   to remove it three months later. *@
<div class="card">
    <div class="card-header py-2">
        <strong class="small">Transaction Schedule</strong>
        <span class="text-muted small ms-1">
            Leave the end month blank for an allowance that runs indefinitely.
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Code</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">From</th>
                        <th class="text-center">To</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody id="tsBody">
                    <tr><td colspan="8" class="text-center py-4 text-muted">Choose an employee.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="tsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="tsModalTitle">Add Entry</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tsRowId">
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small">Code <span class="text-danger">*</span></label>
                        <select id="tsComponent" class="form-select" data-search onchange="tsComponentChanged()"></select>
                        <div class="form-text small" id="tsComponentHint"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Amount <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" id="tsAmount" class="form-control">
                    </div>
                    @* Month inputs rather than raw yyyymm boxes — the browser knows how to
                       enter a month, and typing 202613 by hand is a real mistake. *@
                    <div class="col-md-6">
                        <label class="form-label small">From <span class="text-danger">*</span></label>
                        <input type="month" id="tsFrom" class="form-control">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">To</label>
                        <input type="month" id="tsTo" class="form-control">
                        <div class="form-text small">Blank runs indefinitely.</div>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-light border py-2 small mb-0" id="tsPreview"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="tsSave()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/transaction-schedule.js" asp-append-version="true"></script>
}
