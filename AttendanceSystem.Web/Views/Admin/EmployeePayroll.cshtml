@{
    ViewData["Title"] = "Employee Payroll";
}

<div class="mb-3">
    <h5 class="mb-0">Employee Payroll</h5>
    <div class="text-muted small">
        Grade, statutory numbers and bank details for each employee — and who is not yet ready to be paid.
    </div>
</div>

<div class="row g-2 mb-3" id="epSummary"></div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Search</label>
                <input type="text" id="epSearch" class="form-control form-control-sm"
                       placeholder="Name, code or EPF number…" oninput="epFilter()">
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Department</label>
                <select id="epDept" class="form-select form-select-sm" onchange="epFilter()">
                    <option value="">All departments</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Setup status</label>
                <select id="epReady" class="form-select form-select-sm" onchange="epFilter()">
                    <option value="">Everyone</option>
                    <option value="false">Not ready for payroll</option>
                    <option value="true">Ready</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Code</th>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Category</th>
                        <th>Grade</th>
                        <th class="text-end">Basic</th>
                        <th>EPF No.</th>
                        <th>Bank</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Setup</th>
                    </tr>
                </thead>
                <tbody id="epBody">
                    <tr><td colspan="10" class="text-center py-4 text-muted">Loading…</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/employee-payroll-list.js" asp-append-version="true"></script>
}
