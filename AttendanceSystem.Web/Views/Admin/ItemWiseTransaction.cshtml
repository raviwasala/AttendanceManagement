@{
    ViewData["Title"] = "Item wise Transaction";
}

<div class="mb-3">
    <h5 class="mb-0">Item wise Transaction</h5>
    <div class="text-muted small">
        One allowance or deduction, one month, an amount for each employee.
    </div>
</div>

<div id="iwAlert"></div>

@* Item and month first, because nothing below means anything until both are chosen —
   the same figure is a bonus in one month and an error in another. *@
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">
                    Item <span class="text-danger">*</span>
                </label>
                <select id="iwComponent" class="form-select" data-search onchange="iwLoad()"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">
                    Month <span class="text-danger">*</span>
                </label>
                <input type="month" id="iwMonth" class="form-control" onchange="iwLoad()">
            </div>
            <div class="col-md-4">
                <label class="form-label small">&nbsp;</label>
                <div class="alert alert-light border py-2 small mb-0" id="iwItemHint">
                    Choose an item to begin.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header py-2 d-flex justify-content-between align-items-center">
        <div>
            <strong class="small" id="iwGridTitle">Employees</strong>
            <span class="text-muted small ms-2" id="iwGridCount"></span>
        </div>
        <div>
            <button class="btn btn-sm btn-outline-secondary" onclick="iwClearAll()" id="iwClearBtn" disabled>
                Clear all amounts
            </button>
            <button class="btn btn-sm btn-primary ms-1" onclick="iwSave()" id="iwSaveBtn" disabled>
                <i class="feather icon-check me-1"></i>Save
            </button>
        </div>
    </div>

    <div class="card-body py-2">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" id="iwSearch" class="form-control form-control-sm"
                       placeholder="Search name or code…" oninput="iwFilter()">
            </div>
            <div class="col-md-4">
                <select id="iwDept" class="form-select form-select-sm" onchange="iwFilter()">
                    <option value="">All departments</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" id="iwEnteredOnly" onchange="iwFilter()">
                    <label class="form-check-label small" for="iwEnteredOnly">With an amount only</label>
                </div>
            </div>
        </div>
    </div>

    @* Filtering hides rows but never drops their values: the save posts every row that has
       been loaded, so narrowing to one department cannot wipe the rest of the month. *@
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height:520px;overflow-y:auto;">
            <table class="table table-hover table-sm mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width:110px;">Code</th>
                        <th>Employee</th>
                        <th style="width:160px;">Department</th>
                        <th class="text-end" style="width:110px;">Usual</th>
                        <th class="text-end" style="width:140px;">Amount</th>
                        <th style="width:200px;">Remarks</th>
                    </tr>
                </thead>
                <tbody id="iwBody">
                    <tr><td colspan="6" class="text-center py-4 text-muted">
                        Choose an item and a month.
                    </td></tr>
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="4" class="text-end pe-2">Total</th>
                        <th class="text-end" id="iwTotal">0.00</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/item-wise-transaction.js" asp-append-version="true"></script>
}
