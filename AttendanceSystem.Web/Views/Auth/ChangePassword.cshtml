@model AttendanceSystem.Application.DTOs.ChangePasswordDto
@{
    ViewData["Title"] = "Change Password";
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col-auto">
            <h5 class="page-title mb-0">Change Password</h5>
        </div>
        <div class="col-auto ms-auto">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Auth" asp-action="Profile">My Profile</a></li>
                    <li class="breadcrumb-item active">Change Password</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-5 col-md-7">
        <div class="card">
            <div class="card-header" style="background:#01a9ac;">
                <h5 class="card-header-text text-white mb-0">
                    <i class="fa fa-lock me-2"></i>Change Password
                </h5>
            </div>
            <div class="card-block p-4">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
                        <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"
                         class="alert alert-danger py-2 mb-3" style="font-size:.85rem;"></div>

                    <div class="form-group mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold">
                            <i class="fa fa-lock me-1" style="color:#01a9ac;"></i>Current Password
                        </label>
                        <input asp-for="CurrentPassword" class="form-control"
                               type="password" placeholder="Enter current password"
                               autocomplete="current-password">
                        <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">
                            <i class="fa fa-key me-1" style="color:#01a9ac;"></i>New Password
                        </label>
                        <input asp-for="NewPassword" class="form-control"
                               type="password" placeholder="At least 8 characters"
                               autocomplete="new-password">
                        <span asp-validation-for="NewPassword" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                            <i class="fa fa-check-circle me-1" style="color:#01a9ac;"></i>Confirm New Password
                        </label>
                        <input asp-for="ConfirmPassword" class="form-control"
                               type="password" placeholder="Re-enter new password"
                               autocomplete="new-password">
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa fa-save me-1"></i>Update Password
                        </button>
                        <a asp-controller="Auth" asp-action="Profile"
                           class="btn btn-secondary px-4">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
