@model AttendanceSystem.Application.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <title>Forgot Password – Attendance Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/icon/icofont/css/icofont.css">
    <link rel="stylesheet" href="~/assets/icon/feather/css/feather.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        body { margin: 0; }
        .auth-box .form-control { border-radius: 3px; }
        .auth-box .btn-signin {
            display: block;
            width: 100%;
            padding: .75rem 1rem;
            background-color: #01a9ac;
            border: none;
            border-radius: 3px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: .4px;
            cursor: pointer;
            transition: background .2s;
        }
        .auth-box .btn-signin:hover  { background-color: #018f92; }
        .auth-box .btn-signin:active { background-color: #017b7e; }
        .auth-box .forgot-link {
            color: #01a9ac;
            font-size: .88rem;
            font-weight: 600;
            text-decoration: none;
        }
        .auth-box .forgot-link:hover { text-decoration: underline; }
        .auth-footer { font-size: .82rem; color: #adb5bd; }
        .auth-footer strong { display: block; font-weight: 600; color: #6c757d; }
    </style>
</head>
<body>

<section class="login-block">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">

                <!-- Brand logo -->
                <div class="text-center mb-4">
                    <img src="~/assets/images/samanmal_logo.png" alt="Samanmal Life Style Store"
                         style="max-height: 120px; height: auto; max-width: 320px; width: auto; vertical-align: middle; filter: drop-shadow(0 6px 16px rgba(0,0,0,0.55));"
                         onerror="this.src='/assets/images/logo.png'" />
                </div>

                <!-- Auth card -->
                <div class="auth-box card">
                    <div class="card-block p-4">

                        <!-- Heading -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <p class="text-center mb-1"
                                   style="font-size:1.5rem;font-weight:600;color:#404E67;">
                                    Forgot Password
                                </p>
                                <p class="text-center text-muted mb-0" style="font-size:.85rem;">
                                    Enter your registered Email address or Username to receive a password reset link.
                                </p>
                            </div>
                        </div>

                        <!-- Confirmation message -->
                        @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage as string))
                        {
                            <div class="alert alert-success border-success py-3 mb-4" role="alert">
                                <div class="d-flex align-items-start">
                                    <i class="icofont icofont-email me-2" style="font-size:1.4rem; color:#2e7d32;"></i>
                                    <div>
                                        <strong style="font-size:.95rem; display:block;" class="mb-1">Check Your Inbox</strong>
                                        <span style="font-size:.85rem; color:#333;">@ViewBag.SuccessMessage</span>
                                    </div>
                                </div>
                            </div>

                            <a asp-action="Login" class="btn-signin text-center text-decoration-none mb-3">Return to Sign In</a>
                        }
                        else
                        {
                            <!-- Error summary -->
                            <div asp-validation-summary="All" class="text-danger mb-3" style="font-size:.85rem;"></div>

                            <!-- Reset Form -->
                            <form asp-action="ForgotPassword" method="post" novalidate>
                                @Html.AntiForgeryToken()

                                <div class="form-group mb-3">
                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Email Address or Username"
                                           autofocus
                                           autocomplete="email">
                                    <span asp-validation-for="Email"
                                          class="text-danger" style="font-size:.8rem;"></span>
                                </div>

                                <button type="submit" class="btn-signin mb-3">Send Reset Link</button>

                                <div class="text-center">
                                    <a asp-action="Login" class="forgot-link">
                                        <i class="feather icon-arrow-left me-1"></i> Back to Sign In
                                    </a>
                                </div>
                            </form>
                        }

                        <!-- Footer row -->
                        <hr class="mt-4 mb-3">
                        <div class="d-flex align-items-center justify-content-between auth-footer">
                            <div>
                                <span>Thank you.</span>
                                <strong>Attendance Management System</strong>
                            </div>
                            <span style="font-size:2rem;color:#01a9ac;">
                                <i class="icofont icofont-ui-clock"></i>
                            </span>
                        </div>

                    </div>
                </div><!-- /auth-box -->

            </div>
        </div>
    </div>
</section>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
