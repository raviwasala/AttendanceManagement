@model AttendanceSystem.Application.DTOs.LoginDto
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <title>Sign In – Attendance Management System</title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <!-- Icofont (template icon set) -->
    <link rel="stylesheet" href="~/assets/icon/icofont/css/icofont.css">
    <!-- Feather icons -->
    <link rel="stylesheet" href="~/assets/icon/feather/css/feather.css">
    <!-- Adminty template core styles (includes .login-block / .auth-box) -->
    <link rel="stylesheet" href="~/assets/css/style.css">
    <!-- Teal palette overrides -->
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        body { margin: 0; }
        .auth-box .form-control { border-radius: 3px; }
        .auth-box .btn-signin {
            display: block;
            width: 100%;
            padding: .75rem 1rem;
            background-color: #01a9ac;
            border: none;
            border-radius: 3px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: .4px;
            cursor: pointer;
            transition: background .2s;
        }
        .auth-box .btn-signin:hover  { background-color: #018f92; }
        .auth-box .btn-signin:active { background-color: #017b7e; }
        .auth-box .forgot-link {
            color: #01a9ac;
            font-size: .88rem;
            font-weight: 600;
            text-decoration: none;
        }
        .auth-box .forgot-link:hover { text-decoration: underline; }
        .auth-box .form-check-label  { font-size: .88rem; color: #6c757d; }
        .auth-footer { font-size: .82rem; color: #adb5bd; }
        .auth-footer strong { display: block; font-weight: 600; color: #6c757d; }
    </style>
</head>
<body>

<section class="login-block">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">

                <!-- Brand bar -->
                <div class="text-center mb-4">
                    <span class="text-white"
                          style="font-size:1.4rem;font-weight:700;letter-spacing:.5px;">
                        <i class="icofont icofont-ui-clock"
                           style="color:#01a9ac;font-size:1.6rem;vertical-align:middle;"></i>
                        &nbsp;Attendance Management System
                    </span>
                </div>

                <!-- Auth card -->
                <div class="auth-box card">
                    <div class="card-block p-4">

                        <!-- Heading -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <p class="text-center mb-0"
                                   style="font-size:1.5rem;font-weight:600;color:#404E67;">
                                    Sign In
                                </p>
                            </div>
                        </div>

                        <!-- Error alert -->
                        @if (!string.IsNullOrEmpty(TempData["Error"] as string))
                        {
                            <div class="alert alert-danger alert-dismissible fade show py-2 mb-3"
                                 role="alert" style="font-size:.85rem;">
                                @TempData["Error"]
                                <button type="button" class="btn-close btn-sm"
                                        data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <!-- Login form -->
                        <form asp-action="Login" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="form-group mb-3">
                                <input asp-for="Username"
                                       class="form-control"
                                       placeholder="Username"
                                       autofocus
                                       autocomplete="username">
                                <span asp-validation-for="Username"
                                      class="text-danger" style="font-size:.8rem;"></span>
                            </div>

                            <div class="form-group mb-2">
                                <input asp-for="Password"
                                       class="form-control"
                                       type="password"
                                       placeholder="Password"
                                       autocomplete="current-password">
                                <span asp-validation-for="Password"
                                      class="text-danger" style="font-size:.8rem;"></span>
                            </div>

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-2" style="font-size:.83rem;"></div>

                            <!-- Remember me / Forgot password -->
                            <div class="row mt-2 mb-3">
                                <div class="col-6">
                                    <div class="form-check">
                                        <input asp-for="RememberMe"
                                               class="form-check-input"
                                               type="checkbox"
                                               id="rememberMe">
                                        <label class="form-check-label" for="rememberMe">
                                            Remember me
                                        </label>
                                    </div>
                                </div>
                                <div class="col-6 text-end">
                                    <a href="#" class="forgot-link">Forgot Password?</a>
                                </div>
                            </div>

                            <button type="submit" class="btn-signin">Sign In</button>
                        </form>

                        <!-- Footer row -->
                        <hr class="mt-4 mb-3">
                        <div class="d-flex align-items-center justify-content-between auth-footer">
                            <div>
                                <span>Thank you.</span>
                                <strong>Attendance Management System</strong>
                            </div>
                            <span style="font-size:2rem;color:#01a9ac;">
                                <i class="icofont icofont-ui-clock"></i>
                            </span>
                        </div>

                    </div>
                </div><!-- /auth-box -->

            </div>
        </div>
    </div>
</section>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
