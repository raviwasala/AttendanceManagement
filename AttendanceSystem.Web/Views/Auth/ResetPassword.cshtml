@model AttendanceSystem.Application.DTOs.ResetPasswordWithTokenDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <title>Reset Password – Attendance Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/icon/icofont/css/icofont.css">
    <link rel="stylesheet" href="~/assets/icon/feather/css/feather.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        body { margin: 0; }
        .auth-box .form-control { border-radius: 3px; }
        .auth-box .btn-signin {
            display: block;
            width: 100%;
            padding: .75rem 1rem;
            background-color: #01a9ac;
            border: none;
            border-radius: 3px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: .4px;
            cursor: pointer;
            transition: background .2s;
        }
        .auth-box .btn-signin:hover  { background-color: #018f92; }
        .auth-box .btn-signin:active { background-color: #017b7e; }
        .auth-box .forgot-link {
            color: #01a9ac;
            font-size: .88rem;
            font-weight: 600;
            text-decoration: none;
        }
        .auth-box .forgot-link:hover { text-decoration: underline; }
        .auth-footer { font-size: .82rem; color: #adb5bd; }
        .auth-footer strong { display: block; font-weight: 600; color: #6c757d; }
    </style>
</head>
<body>

<section class="login-block">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">

                <!-- Brand logo -->
                <div class="text-center mb-4">
                    <img src="~/assets/images/samanmal_logo.png" alt="Samanmal Life Style Store"
                         style="max-height: 120px; height: auto; max-width: 320px; width: auto; vertical-align: middle; filter: drop-shadow(0 6px 16px rgba(0,0,0,0.55));"
                         onerror="this.src='/assets/images/logo.png'" />
                </div>

                <!-- Auth card -->
                <div class="auth-box card">
                    <div class="card-block p-4">

                        <!-- Heading -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <p class="text-center mb-1"
                                   style="font-size:1.5rem;font-weight:600;color:#404E67;">
                                    Reset Password
                                </p>
                                <p class="text-center text-muted mb-0" style="font-size:.85rem;">
                                    Create a new password for your account.
                                </p>
                            </div>
                        </div>

                        <!-- Success alert -->
                        @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage as string))
                        {
                            <div class="alert alert-success border-success py-3 mb-4" role="alert">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="icofont icofont-check-circled me-2" style="font-size:1.4rem;"></i>
                                    <strong style="font-size:.95rem;">Password Updated!</strong>
                                </div>
                                <p class="mb-0" style="font-size:.85rem; color:#2e7d32;">@ViewBag.SuccessMessage</p>
                            </div>

                            <a asp-action="Login" class="btn-signin text-center text-decoration-none mb-3">Sign In Now</a>
                        }
                        else
                        {
                            <!-- Error summary -->
                            <div asp-validation-summary="All" class="text-danger mb-3" style="font-size:.85rem;"></div>

                            <!-- Reset Password Form -->
                            <form asp-action="ResetPassword" method="post" novalidate>
                                @Html.AntiForgeryToken()

                                <div class="form-group mb-3">
                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Email Address or Username"
                                           autocomplete="email">
                                    <span asp-validation-for="Email"
                                          class="text-danger" style="font-size:.8rem;"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <input asp-for="Token"
                                           class="form-control font-monospace"
                                           placeholder="Reset Token (from email link)"
                                           autocomplete="off">
                                    <span asp-validation-for="Token"
                                          class="text-danger" style="font-size:.8rem;"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <input asp-for="NewPassword"
                                           class="form-control"
                                           type="password"
                                           placeholder="New Password (min 8 characters)"
                                           autocomplete="new-password">
                                    <span asp-validation-for="NewPassword"
                                          class="text-danger" style="font-size:.8rem;"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <input asp-for="ConfirmPassword"
                                           class="form-control"
                                           type="password"
                                           placeholder="Confirm New Password"
                                           autocomplete="new-password">
                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger" style="font-size:.8rem;"></span>
                                </div>

                                <button type="submit" class="btn-signin mb-3">Update Password</button>

                                <div class="text-center">
                                    <a asp-action="Login" class="forgot-link">
                                        <i class="feather icon-arrow-left me-1"></i> Back to Sign In
                                    </a>
                                </div>
                            </form>
                        }

                        <!-- Footer row -->
                        <hr class="mt-4 mb-3">
                        <div class="d-flex align-items-center justify-content-between auth-footer">
                            <div>
                                <span>Thank you.</span>
                                <strong>Attendance Management System</strong>
                            </div>
                            <span style="font-size:2rem;color:#01a9ac;">
                                <i class="icofont icofont-ui-clock"></i>
                            </span>
                        </div>

                    </div>
                </div><!-- /auth-box -->

            </div>
        </div>
    </div>
</section>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
